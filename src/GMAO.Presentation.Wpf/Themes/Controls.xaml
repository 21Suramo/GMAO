<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Styles de contrôles du design system GMAO. Dépend de Colors.xaml.
        - Styles IMPLICITES (sans x:Key) : Button, TextBox, ComboBox, ListView.
        Ils s'appliquent partout SAUF là où une vue applique déjà un Style explicite
        (ex. UtilisateursView "Champ") ou un template local.
        - Le style Button implicite lit Background/BorderBrush/Padding via TemplateBinding,
        donc les couleurs inline existantes (Background="#2C5364"…) restent respectées.
        - 3 styles nommés de bouton : BoutonPrimaire, BoutonSecondaire, BoutonDanger.
        - Hauteur de champ unifiée : 32 px (valeur dominante dans le code actuel).
    -->

    <!--  ============ BOUTONS ============  -->

    <!--  Base commune (template + comportement), réutilisée par l'implicite et les 3 variantes  -->
    <Style x:Key="BoutonBase" TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource PinceauSurfaceSecondaire}" />
        <Setter Property="Foreground" Value="{StaticResource PinceauTexte}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Fond"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Opacity" Value="0.90" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fond" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fond" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Implicite : tous les boutons héritent du comportement, gardent leurs couleurs inline  -->
    <Style BasedOn="{StaticResource BoutonBase}" TargetType="Button" />

    <!--  Action primaire = vert « moniteur clinique » sur texte anthracite (fort contraste)  -->
    <Style
        x:Key="BoutonPrimaire"
        BasedOn="{StaticResource BoutonBase}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PinceauAccentVert}" />
        <Setter Property="Foreground" Value="{StaticResource PinceauFondHud}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  Action secondaire (surface claire, texte foncé)  -->
    <Style
        x:Key="BoutonSecondaire"
        BasedOn="{StaticResource BoutonBase}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PinceauSurfaceSecondaire}" />
        <Setter Property="Foreground" Value="{StaticResource PinceauTexte}" />
        <Setter Property="BorderBrush" Value="{StaticResource PinceauBordure}" />
    </Style>

    <!--  Action destructive (rouge d'erreur unifié)  -->
    <Style
        x:Key="BoutonDanger"
        BasedOn="{StaticResource BoutonBase}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PinceauErreur}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  ============ CHAMPS DE SAISIE ============  -->

    <!--  Champs de saisie « moniteur » : fond sombre, texte clair, caret vert (app entièrement sombre)  -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#2E3A44" />
        <Setter Property="Foreground" Value="{StaticResource PinceauTexteHud}" />
        <Setter Property="Background" Value="#0E141B" />
        <Setter Property="CaretBrush" Value="{StaticResource PinceauAccentVert}" />
    </Style>

    <!--
        Pas de style ComboBox implicite : on laisse le thème sombre de WPF-UI (ui:ControlsDictionary,
        fusionné avant ce dictionnaire) styliser les listes déroulantes en sombre. Un override
        « propriétés seules » ici retomberait sur le template clair classique de WPF.
    -->

    <!--  ============ LISTES ============  -->

    <Style TargetType="ListView">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource PinceauBordure}" />
        <Setter Property="Background" Value="{StaticResource PinceauSurface}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!--
        Ligne de tableau sombre (HUD) : zébrage, séparateur, survol, sélection nette.
        À utiliser avec ListView AlternationCount="2" + Background transparent sur fond sombre.
    -->
    <Style x:Key="LigneTableHud" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource PinceauTexteHud}" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border
                        x:Name="Bord"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        BorderBrush="{StaticResource PinceauSeparateurHud}"
                        BorderThickness="0,0,0,1">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter TargetName="Bord" Property="Background" Value="{StaticResource PinceauLigneImpaireHud}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bord" Property="Background" Value="{StaticResource PinceauSurvolHud}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bord" Property="Background" Value="{StaticResource PinceauSelectionHud}" />
                            <Setter TargetName="Bord" Property="BorderBrush" Value="{StaticResource PinceauAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Élément de liste « mini-card » (HUD) : pas de séparateur/zébrage, survol + sélection
        matérialisés par un fond cyan translucide et un liseré cyan autour de la carte.
    -->
    <Style x:Key="LigneCarteHud" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource PinceauTexteHud}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border
                        x:Name="Bord"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="11">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bord" Property="Background" Value="{StaticResource PinceauSurvolHud}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bord" Property="Background" Value="{StaticResource PinceauSelectionHud}" />
                            <Setter TargetName="Bord" Property="BorderBrush" Value="{StaticResource PinceauAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============ SIGNATURE « MONITEUR CLINIQUE » ============  -->

    <!--
        Carte de moniteur : coins peu arrondis (5 px), fond surface HUD, liseré 1 px.
        La couleur du liseré est « bindable selon statut » : par défaut liseré vert discret,
        chaque instance peut le surcharger via BorderBrush="{Binding StatutPinceau}"
        (ex. rouge = patient connecté / critique, ambre = alerte, vert = nominal).
    -->
    <Style x:Key="CardMoniteur" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PinceauSurfaceHud}" />
        <Setter Property="BorderBrush" Value="{StaticResource PinceauSurfaceHudBordure}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        Point de statut pulsant : pastille dont l'opacité oscille en boucle douce (respiration).
        Couleur « bindable » via Fill sur l'instance (défaut vert nominal).
        Usage : <Ellipse Style="{StaticResource PointStatutPulsant}" Fill="{StaticResource PinceauErreur}" />
    -->
    <Style x:Key="PointStatutPulsant" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Fill" Value="{StaticResource PinceauAccentVert}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation
                            AutoReverse="True"
                            RepeatBehavior="Forever"
                            Storyboard.TargetProperty="Opacity"
                            From="1.0"
                            To="0.28"
                            Duration="0:0:1.1">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Tracé décoratif « courbe de moniteur » (allure ECG), accent vert, faible opacité.
        Réutilisable : <Path Style="{StaticResource CourbeMoniteur}" Height="46" /> — Stretch=Fill
        l'étire à la largeur du conteneur. Non interactif.
    -->
    <StreamGeometry x:Key="GeometrieCourbeMoniteur">M0,24 L28,24 L34,24 L40,18 L46,24 L70,24 L76,24 L82,8 L88,40 L94,16 L100,24 L140,24 L146,24 L152,18 L158,24 L182,24 L188,24 L194,8 L200,40 L206,16 L212,24 L252,24</StreamGeometry>

    <Style x:Key="CourbeMoniteur" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource GeometrieCourbeMoniteur}" />
        <Setter Property="Stroke" Value="{StaticResource PinceauAccentVert}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="Opacity" Value="0.16" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

</ResourceDictionary>
