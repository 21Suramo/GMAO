<Application
    x:Class="GMAO.Presentation.Wpf.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:GMAO.Presentation.Wpf.Views"
    xmlns:vm="clr-namespace:GMAO.Presentation.Wpf.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Association ViewModel -> Vue (navigation implicite via ContentControl)  -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatistiquesViewModel}">
                <views:StatistiquesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ParcViewModel}">
                <views:ParcView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InterventionsViewModel}">
                <views:InterventionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PiecesViewModel}">
                <views:PieceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RapportsViewModel}">
                <views:RapportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UtilisateursViewModel}">
                <views:UtilisateursView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ParametresViewModel}">
                <views:ParametresView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
