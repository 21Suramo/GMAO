<UserControl x:Class="GMAO.Presentation.Wpf.Views.PieceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GMAO.Presentation.Wpf.Converters"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:NiveauAlerteVersCouleurConverter x:Key="AlerteCouleur"/>
        <conv:NullVersVisibiliteConverter x:Key="NullVisib"/>
        <conv:StringVersVisibiliteConverter x:Key="StrVisib"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Liste -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="6">
            <Border.Effect><DropShadowEffect Color="#22000000" BlurRadius="14" ShadowDepth="2" Direction="270"/></Border.Effect>
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,12,14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Stock des pièces détachées" FontSize="16" FontWeight="SemiBold" Foreground="#203A43" VerticalAlignment="Center"/>
                        <Border Background="#FFEBEE" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Foreground="#C62828" FontSize="11" FontWeight="SemiBold">
                                <Run Text="{Binding NombreAlertes}"/><Run Text=" alertes"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <Button Content="Actualiser" HorizontalAlignment="Right" Padding="10,4"
                            Background="#ECEFF1" BorderThickness="0" Foreground="#37474F" Cursor="Hand"
                            Command="{Binding ChargerCommand}"/>
                </Grid>
                <ListView ItemsSource="{Binding Pieces}" SelectedItem="{Binding Selection, Mode=TwoWay}" BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" CornerRadius="8" Margin="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" FontSize="14" Foreground="#263238"/>
                                        <TextBlock FontSize="12" Foreground="#90A4AE">
                                            <Run Text="{Binding Reference}"/><Run Text="  ·  "/><Run Text="{Binding Emplacement}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock HorizontalAlignment="Right" FontWeight="Bold" FontSize="15" Foreground="#37474F">
                                            <Run Text="{Binding Stock}"/><Run Text=" u."/>
                                        </TextBlock>
                                        <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="#B0BEC5">
                                            <Run Text="min "/><Run Text="{Binding StockMinimum}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="10" Padding="8,3" VerticalAlignment="Center"
                                            Background="{Binding NiveauAlerte, Converter={StaticResource AlerteCouleur}}">
                                        <TextBlock Text="{Binding NiveauAlerte}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Détail -->
        <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="22"
                Visibility="{Binding Selection, Converter={StaticResource NullVisib}}">
            <Border.Effect><DropShadowEffect Color="#22000000" BlurRadius="14" ShadowDepth="2" Direction="270"/></Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <StackPanel DataContext="{Binding Selection}">
                    <TextBlock Text="{Binding Nom}" FontSize="20" FontWeight="Bold" Foreground="#203A43" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Reference}" Foreground="#90A4AE" Margin="0,2,0,0"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Stock" Foreground="#78909C" Margin="0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,3" Foreground="#37474F"><Run Text="{Binding Stock}"/><Run Text=" unités (min "/><Run Text="{Binding StockMinimum}"/><Run Text=")"/></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Emplacement" Foreground="#78909C" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Emplacement}" Margin="12,3" Foreground="#37474F"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Prix unitaire" Foreground="#78909C" Margin="0,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Prix, StringFormat={}{0:N2} MAD}" Margin="12,3" Foreground="#37474F"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Compatible" Foreground="#78909C" Margin="0,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Compatible}" Margin="12,3" Foreground="#37474F" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Catégorie" Foreground="#78909C" Margin="0,3"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CategorieNom, TargetNullValue=—}" Margin="12,3" Foreground="#37474F"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Fournisseur" Foreground="#78909C" Margin="0,3"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FournisseurNom, TargetNullValue=—}" Margin="12,3" Foreground="#37474F"/>
                    </Grid>

                    <!-- Pannes associées -->
                    <TextBlock Text="PANNES ASSOCIÉES" FontSize="11" FontWeight="SemiBold" Foreground="#90A4AE" Margin="0,16,0,6"/>
                    <ItemsControl ItemsSource="{Binding PannesAssociees}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF3E0" CornerRadius="8" Padding="8,4" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}" Foreground="#EF6C00" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Mouvement de stock -->
                <Border Height="1" Background="#ECEFF1" Margin="0,18"/>
                <TextBlock Text="MOUVEMENT DE STOCK" FontSize="11" FontWeight="SemiBold" Foreground="#90A4AE" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding TypesMouvement}" SelectedItem="{Binding TypeMouvement}" Height="32" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Quantite, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                </Grid>
                <TextBox Text="{Binding Motif, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,8,0,0" Padding="6,0"
                         VerticalContentAlignment="Center" BorderBrush="#CFD8DC"
                         ToolTip="Motif (facultatif)"/>
                <Button Content="Enregistrer le mouvement" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,7"
                        Background="#2C5364" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Command="{Binding EnregistrerMouvementCommand}"/>
                <TextBlock Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource StrVisib}}"
                           Foreground="#0277BD" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
