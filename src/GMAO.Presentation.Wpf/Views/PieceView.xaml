<UserControl
    x:Class="GMAO.Presentation.Wpf.Views.PieceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:GMAO.Presentation.Wpf.Converters"
    Background="{StaticResource PinceauFondHud}"
    FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:NiveauAlerteVersCouleurConverter x:Key="AlerteCouleur" />
        <conv:NullVersVisibiliteConverter x:Key="NullVisib" />
        <conv:StringVersVisibiliteConverter x:Key="StrVisib" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Liste  -->
        <Border
            Grid.Column="0"
            Padding="6"
            Background="{StaticResource PinceauSurfaceHud}"
            CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    ShadowDepth="2"
                    Color="#22000000" />
            </Border.Effect>
            <DockPanel>
                <Grid Margin="14,12,14,8" DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PinceauTexteHud}"
                            Text="Stock des pièces détachées" />
                        <Border
                            Margin="10,0,0,0"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="#22FF3B30"
                            BorderBrush="#66FF3B30"
                            BorderThickness="1"
                            CornerRadius="9">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#FF6B60">
                                <Run Text="{Binding NombreAlertes}" /><Run Text=" alertes" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <Button
                        Padding="10,4"
                        HorizontalAlignment="Right"
                        Background="{StaticResource PinceauChipHud}"
                        BorderThickness="0"
                        Command="{Binding ChargerCommand}"
                        Content="Actualiser"
                        Cursor="Hand"
                        Foreground="{StaticResource PinceauTexteHud}" />
                </Grid>
                <ListView
                    AlternationCount="2"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource LigneTableHud}"
                    ItemsSource="{Binding Pieces}"
                    SelectedItem="{Binding Selection, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="2"
                                Padding="10"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource PinceauTexteHud}"
                                            Text="{Binding Nom}" />
                                        <TextBlock
                                            FontFamily="Cascadia Code, Consolas"
                                            FontSize="12"
                                            Foreground="#90A4AE">
                                            <Run Text="{Binding Reference}" /><Run Text="  ·  " /><Run Text="{Binding Emplacement}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="8,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource PinceauTexteHud}">
                                            <Run Text="{Binding Stock}" /><Run Text=" u." />
                                        </TextBlock>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="10"
                                            Foreground="#B0BEC5">
                                            <Run Text="min " /><Run Text="{Binding StockMinimum}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="{Binding NiveauAlerte, Converter={StaticResource AlerteCouleur}}"
                                        CornerRadius="10">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding NiveauAlerte}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>

        <!--  Détail  -->
        <Border
            Grid.Column="2"
            Padding="22"
            Background="{StaticResource PinceauSurfaceHud}"
            CornerRadius="6"
            Visibility="{Binding Selection, Converter={StaticResource NullVisib}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    ShadowDepth="2"
                    Color="#22000000" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel DataContext="{Binding Selection}">
                        <TextBlock
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{StaticResource PinceauTexteHud}"
                            Text="{Binding Nom}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontFamily="Cascadia Code, Consolas"
                            Foreground="#90A4AE"
                            Text="{Binding Reference}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,3"
                                Foreground="#78909C"
                                Text="Stock" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="12,3"
                                Foreground="{StaticResource PinceauTexteHud}"><Run Text="{Binding Stock}" /><Run Text=" unités (min " /><Run Text="{Binding StockMinimum}" /><Run Text=")" /></TextBlock>
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,3"
                                Foreground="#78909C"
                                Text="Emplacement" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="12,3"
                                Foreground="{StaticResource PinceauTexteHud}"
                                Text="{Binding Emplacement}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,3"
                                Foreground="#78909C"
                                Text="Prix unitaire" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="12,3"
                                FontFamily="Cascadia Code, Consolas"
                                Foreground="{StaticResource PinceauTexteHud}"
                                Text="{Binding Prix, StringFormat={}{0:N2} MAD}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,3"
                                Foreground="#78909C"
                                Text="Compatible" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="12,3"
                                Foreground="{StaticResource PinceauTexteHud}"
                                Text="{Binding Compatible}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,3"
                                Foreground="#78909C"
                                Text="Catégorie" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Margin="12,3"
                                Foreground="{StaticResource PinceauTexteHud}"
                                Text="{Binding CategorieNom, TargetNullValue=—}" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Margin="0,3"
                                Foreground="#78909C"
                                Text="Fournisseur" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Margin="12,3"
                                Foreground="{StaticResource PinceauTexteHud}"
                                Text="{Binding FournisseurNom, TargetNullValue=—}" />
                        </Grid>

                        <!--  Pannes associées  -->
                        <TextBlock
                            Margin="0,16,0,6"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#90A4AE"
                            Text="PANNES ASSOCIÉES" />
                        <ItemsControl ItemsSource="{Binding PannesAssociees}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,4"
                                        Padding="8,4"
                                        Background="#22FFB300"
                                        CornerRadius="6">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#FFB300"
                                            Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--  Mouvement de stock  -->
                    <Border
                        Height="1"
                        Margin="0,18"
                        Background="{StaticResource PinceauChipHud}" />
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#90A4AE"
                        Text="MOUVEMENT DE STOCK" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Grid.Column="0"
                            Height="32"
                            Margin="0,0,8,0"
                            ItemsSource="{Binding TypesMouvement}"
                            SelectedItem="{Binding TypeMouvement}" />
                        <TextBox
                            Grid.Column="1"
                            Height="32"
                            Padding="6,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding Quantite, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBox
                        Height="30"
                        Margin="0,8,0,0"
                        Padding="6,0"
                        VerticalContentAlignment="Center"
                        BorderBrush="#CFD8DC"
                        Text="{Binding Motif, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Motif (facultatif)" />
                    <Button
                        Margin="0,10,0,0"
                        Padding="12,7"
                        HorizontalAlignment="Left"
                        Background="#00E5A8"
                        BorderThickness="0"
                        Command="{Binding EnregistrerMouvementCommand}"
                        Content="Enregistrer le mouvement"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Foreground="#0A0E12" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="#29B6F6"
                        Text="{Binding Message}"
                        TextWrapping="Wrap"
                        Visibility="{Binding Message, Converter={StaticResource StrVisib}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
