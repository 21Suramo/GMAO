<UserControl
    x:Class="GMAO.Presentation.Wpf.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:GMAO.Presentation.Wpf.Converters"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:BoolVersVisibiliteConverter x:Key="BoolVisib" />

        <!--  Carte KPI moderne : accent coloré à gauche, ombre douce  -->
        <Style x:Key="CarteKpi" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Width" Value="205" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="16"
                        Direction="270"
                        ShadowDepth="3"
                        Color="#1E000000" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KpiValeur" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1B2A33" />
        </Style>
        <Style x:Key="KpiLibelle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#78909C" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CartePanneau" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="16"
                        Direction="270"
                        ShadowDepth="3"
                        Color="#1E000000" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitrePanneau" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#203A43" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!--  Ligne de classement (top N) avec barre proportionnelle  -->
        <DataTemplate x:Key="LigneClassement">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Background="#ECEFF1"
                    CornerRadius="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#546E7A"
                        Text="{Binding Rang}" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="13"
                        Foreground="#37474F"
                        Text="{Binding Libelle}"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        Width="{Binding LargeurBarre}"
                        Height="6"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Left"
                        Background="#4FC3F7"
                        CornerRadius="3" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#203A43"
                    Text="{Binding Valeur}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <!--  Bannière moderne  -->
            <Border Margin="0,0,0,22" Padding="28,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#203A43" />
                        <GradientStop Offset="1" Color="#2C5364" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Tableau de bord" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#B3E5FC"
                                Text="{Binding Kpi.PerimetreLibelle}" />
                            <TextBlock
                                FontSize="13"
                                Foreground="#78909C"
                                Text="  ·  " />
                            <TextBlock
                                FontSize="13"
                                Foreground="#CFD8DC"
                                Text="{Binding Kpi.PeriodeLibelle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ComboBox
                            Width="190"
                            Height="34"
                            VerticalContentAlignment="Center"
                            DisplayMemberPath="Libelle"
                            ItemsSource="{Binding Periodes}"
                            SelectedItem="{Binding PeriodeSelectionnee, Mode=TwoWay}" />
                        <Button
                            Width="34"
                            Height="34"
                            Margin="8,0,0,0"
                            Background="#33FFFFFF"
                            BorderThickness="0"
                            Command="{Binding ChargerCommand}"
                            Content="&#xE72C;"
                            Cursor="Hand"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="16"
                            Foreground="White"
                            ToolTip="Rafraîchir" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Margin="28,0">
                <!--  KPI de flux et de performance  -->
                <WrapPanel>
                    <Border
                        BorderBrush="#F9A825"
                        BorderThickness="0,0,0,4"
                        Style="{StaticResource CarteKpi}">
                        <StackPanel>
                            <TextBlock
                                Foreground="#F9A825"
                                Style="{StaticResource KpiValeur}"
                                Text="{Binding Kpi.InterventionsActives}" />
                            <TextBlock Style="{StaticResource KpiLibelle}" Text="Interventions actives" />
                        </StackPanel>
                    </Border>
                    <Border
                        BorderBrush="#E53935"
                        BorderThickness="0,0,0,4"
                        Style="{StaticResource CarteKpi}">
                        <StackPanel>
                            <TextBlock
                                Foreground="#E53935"
                                Style="{StaticResource KpiValeur}"
                                Text="{Binding Kpi.PannesAujourdhui}" />
                            <TextBlock Style="{StaticResource KpiLibelle}" Text="Pannes déclarées aujourd'hui" />
                        </StackPanel>
                    </Border>
                    <Border
                        BorderBrush="#C62828"
                        BorderThickness="0,0,0,4"
                        Style="{StaticResource CarteKpi}">
                        <StackPanel>
                            <TextBlock
                                Foreground="#C62828"
                                Style="{StaticResource KpiValeur}"
                                Text="{Binding Kpi.InterventionsUrgentes}" />
                            <TextBlock Style="{StaticResource KpiLibelle}" Text="Interventions urgentes" />
                        </StackPanel>
                    </Border>
                    <Border
                        BorderBrush="#D84315"
                        BorderThickness="0,0,0,4"
                        Style="{StaticResource CarteKpi}">
                        <StackPanel>
                            <TextBlock
                                Foreground="#D84315"
                                Style="{StaticResource KpiValeur}"
                                Text="{Binding Kpi.EnDepassementSla}" />
                            <TextBlock Style="{StaticResource KpiLibelle}" Text="En dépassement de délai (SLA)" />
                        </StackPanel>
                    </Border>
                    <Border
                        BorderBrush="#00838F"
                        BorderThickness="0,0,0,4"
                        Style="{StaticResource CarteKpi}">
                        <StackPanel>
                            <TextBlock
                                Foreground="#00838F"
                                Style="{StaticResource KpiValeur}"
                                Text="{Binding Kpi.MttrHeures, StringFormat={}{0} h}" />
                            <TextBlock Style="{StaticResource KpiLibelle}" Text="Temps moyen de résolution (MTTR)" />
                        </StackPanel>
                    </Border>
                    <Border
                        BorderBrush="#6A1B9A"
                        BorderThickness="0,0,0,4"
                        Style="{StaticResource CarteKpi}">
                        <StackPanel>
                            <TextBlock
                                Foreground="#6A1B9A"
                                Style="{StaticResource KpiValeur}"
                                Text="{Binding Kpi.DelaiMoyenAffectationHeures, StringFormat={}{0} h}" />
                            <TextBlock Style="{StaticResource KpiLibelle}" Text="Délai moyen d'affectation" />
                        </StackPanel>
                    </Border>
                    <Border
                        BorderBrush="#2E7D32"
                        BorderThickness="0,0,0,4"
                        Style="{StaticResource CarteKpi}">
                        <StackPanel>
                            <TextBlock
                                Foreground="#2E7D32"
                                Style="{StaticResource KpiValeur}"
                                Text="{Binding Kpi.InterventionsCloturees}" />
                            <TextBlock Style="{StaticResource KpiLibelle}" Text="Clôturées sur la période" />
                        </StackPanel>
                    </Border>
                    <Border
                        BorderBrush="#455A64"
                        BorderThickness="0,0,0,4"
                        Style="{StaticResource CarteKpi}">
                        <StackPanel>
                            <TextBlock
                                Foreground="#455A64"
                                Style="{StaticResource KpiValeur}"
                                Text="{Binding Kpi.CoutCumule, StringFormat={}{0:N0} MAD}" />
                            <TextBlock Style="{StaticResource KpiLibelle}" Text="Coût cumulé (période)" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!--  KPI parc / disponibilité : vue globale uniquement  -->
                <StackPanel Visibility="{Binding VueGlobale, Converter={StaticResource BoolVisib}}">
                    <TextBlock
                        Margin="0,6,0,14"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#203A43"
                        Text="Parc &amp; disponibilité" />
                    <WrapPanel>
                        <Border
                            BorderBrush="#0277BD"
                            BorderThickness="0,0,0,4"
                            Style="{StaticResource CarteKpi}">
                            <StackPanel>
                                <TextBlock
                                    Foreground="#0277BD"
                                    Style="{StaticResource KpiValeur}"
                                    Text="{Binding Kpi.DisponibiliteGlobale, StringFormat={}{0} %}" />
                                <TextBlock Style="{StaticResource KpiLibelle}" Text="Disponibilité des respirateurs" />
                            </StackPanel>
                        </Border>
                        <Border
                            BorderBrush="#455A64"
                            BorderThickness="0,0,0,4"
                            Style="{StaticResource CarteKpi}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource KpiValeur}" Text="{Binding Kpi.NombreRespirateurs}" />
                                <TextBlock Style="{StaticResource KpiLibelle}" Text="Respirateurs au parc" />
                            </StackPanel>
                        </Border>
                        <Border
                            BorderBrush="#2E7D32"
                            BorderThickness="0,0,0,4"
                            Style="{StaticResource CarteKpi}">
                            <StackPanel>
                                <TextBlock
                                    Foreground="#2E7D32"
                                    Style="{StaticResource KpiValeur}"
                                    Text="{Binding Kpi.RespirateursEnService}" />
                                <TextBlock Style="{StaticResource KpiLibelle}" Text="En service" />
                            </StackPanel>
                        </Border>
                        <Border
                            BorderBrush="#C62828"
                            BorderThickness="0,0,0,4"
                            Style="{StaticResource CarteKpi}">
                            <StackPanel>
                                <TextBlock
                                    Foreground="#C62828"
                                    Style="{StaticResource KpiValeur}"
                                    Text="{Binding Kpi.RespirateursHorsService}" />
                                <TextBlock Style="{StaticResource KpiLibelle}" Text="Hors service" />
                            </StackPanel>
                        </Border>
                        <Border
                            BorderBrush="#EF6C00"
                            BorderThickness="0,0,0,4"
                            Style="{StaticResource CarteKpi}">
                            <StackPanel>
                                <TextBlock
                                    Foreground="#EF6C00"
                                    Style="{StaticResource KpiValeur}"
                                    Text="{Binding Kpi.PiecesEnAlerte}" />
                                <TextBlock Style="{StaticResource KpiLibelle}" Text="Pièces en alerte de stock" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!--  Graphiques BI  -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Margin="0,0,9,0"
                        Style="{StaticResource CartePanneau}">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Top"
                                Style="{StaticResource TitrePanneau}"
                                Text="Répartition des interventions par état" />
                            <lvc:PieChart
                                Height="250"
                                LegendPosition="Right"
                                Series="{Binding SeriesEtats}" />
                        </DockPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Margin="9,0,0,0"
                        Style="{StaticResource CartePanneau}">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Top"
                                Style="{StaticResource TitrePanneau}"
                                Text="Interventions par modèle" />
                            <lvc:CartesianChart
                                Height="250"
                                Series="{Binding SeriesModeles}"
                                XAxes="{Binding AxesModeles}" />
                        </DockPanel>
                    </Border>
                </Grid>

                <!--  Top 5 respirateurs + Top 5 hôpitaux  -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Margin="0,0,9,0"
                        Style="{StaticResource CartePanneau}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TitrePanneau}" Text="Top 5 des respirateurs les plus défaillants" />
                            <ItemsControl ItemTemplate="{StaticResource LigneClassement}" ItemsSource="{Binding Top5Respirateurs}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Margin="9,0,0,0"
                        Style="{StaticResource CartePanneau}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TitrePanneau}" Text="Top 5 des hôpitaux" />
                            <ItemsControl ItemTemplate="{StaticResource LigneClassement}" ItemsSource="{Binding Top5Hopitaux}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  Pareto pannes + disponibilité par équipement  -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Margin="0,0,9,0"
                        Style="{StaticResource CartePanneau}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TitrePanneau}" Text="Pareto des pannes récurrentes" />
                            <ItemsControl ItemTemplate="{StaticResource LigneClassement}" ItemsSource="{Binding ParetoPannes}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Margin="9,0,0,0"
                        Style="{StaticResource CartePanneau}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TitrePanneau}" Text="Disponibilité par équipement (%)" />
                            <ItemsControl ItemsSource="{Binding DisponibiliteParEquipement}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel
                                                Grid.Column="0"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="#37474F"
                                                    Text="{Binding Libelle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Border
                                                    Width="{Binding LargeurBarre}"
                                                    Height="6"
                                                    Margin="0,4,0,0"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding Couleur}"
                                                    CornerRadius="3" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#203A43"
                                                Text="{Binding Pourcentage, StringFormat={}{0} %}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  Charge par technicien  -->
                <Border Margin="0,18,0,0" Style="{StaticResource CartePanneau}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitrePanneau}" Text="Charge par technicien" />
                        <Grid Margin="0,0,0,6">
                            <TextBlock
                                FontSize="11"
                                Foreground="#90A4AE"
                                Text="Technicien" />
                            <TextBlock
                                Margin="0,0,70,0"
                                HorizontalAlignment="Right"
                                FontSize="11"
                                Foreground="#90A4AE"
                                Text="En cours" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="11"
                                Foreground="#90A4AE"
                                Text="Terminées" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ChargeParTechnicien}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="#455A64"
                                            Text="{Binding Nom}" />
                                        <TextBlock
                                            Margin="0,0,70,0"
                                            HorizontalAlignment="Right"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#F9A825"
                                            Text="{Binding EnCours}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#2E7D32"
                                            Text="{Binding Terminees}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
