<UserControl
    x:Class="GMAO.Presentation.Wpf.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:GMAO.Presentation.Wpf.Converters"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:BoolVersVisibiliteConverter x:Key="BoolVisib" />

        <!--  Carte KPI « moniteur » : coins peu arrondis, liseré d'état en bas, fond surface HUD  -->
        <Style x:Key="CarteKpi" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PinceauSurfaceHud}" />
            <Setter Property="BorderBrush" Value="{StaticResource PinceauSurfaceHudBordure}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Width" Value="205" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="16"
                        Direction="270"
                        ShadowDepth="3"
                        Color="#40000000" />
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Valeur KPI en police technique monospace (lecture « appareil »)  -->
        <Style x:Key="KpiValeur" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource PinceauTexteHud}" />
        </Style>
        <Style x:Key="KpiLibelle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#78909C" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CartePanneau" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PinceauSurfaceHud}" />
            <Setter Property="BorderBrush" Value="{StaticResource PinceauSurfaceHudBordure}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="16"
                        Direction="270"
                        ShadowDepth="3"
                        Color="#1E000000" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitrePanneau" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource PinceauTexteHud}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!--  Ligne de classement (top N) avec barre proportionnelle  -->
        <DataTemplate x:Key="LigneClassement">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Background="#ECEFF1"
                    CornerRadius="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#546E7A"
                        Text="{Binding Rang}" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource PinceauTexteHud}"
                        Text="{Binding Libelle}"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        Width="{Binding LargeurBarre}"
                        Height="6"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Left"
                        Background="#00E5A8"
                        CornerRadius="3" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="{StaticResource PinceauTexteHud}"
                    Text="{Binding Valeur}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl
        Padding="0"
        Background="{StaticResource PinceauFondHud}"
        BorderThickness="0">
        <!--  Vue « Live » : tableau de bord temps réel (contenu existant, inchangé)  -->
        <TabItem Header="Live">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,24">
                    <!--  Bandeau « moniteur » : fond sombre, liseré vert, courbe ECG décorative + pastille LIVE pulsante  -->
                    <Border
                        Margin="0,0,0,22"
                        Padding="28,22"
                        Background="{StaticResource PinceauSurfaceHud}"
                        BorderBrush="{StaticResource PinceauAccentVert}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="5">
                        <Grid>
                            <!--  Courbe de moniteur décorative, alignée en bas, faible opacité  -->
                            <Path
                                Height="48"
                                Margin="0,0,0,-10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource CourbeMoniteur}" />
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse
                                        Width="9"
                                        Height="9"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PointStatutPulsant}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Cascadia Code, Consolas"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PinceauAccentVert}"
                                        Text="LIVE" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="22"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource PinceauTexteHud}"
                                        Text="Tableau de bord" />
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PinceauAccentVert}"
                                        Text="{Binding Kpi.PerimetreLibelle}" />
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="#78909C"
                                        Text="  ·  " />
                                    <TextBlock
                                        FontFamily="Cascadia Code, Consolas"
                                        FontSize="13"
                                        Foreground="#CFD8DC"
                                        Text="{Binding Kpi.PeriodeLibelle}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ComboBox
                                    Width="190"
                                    Height="34"
                                    VerticalContentAlignment="Center"
                                    DisplayMemberPath="Libelle"
                                    ItemsSource="{Binding Periodes}"
                                    SelectedItem="{Binding PeriodeSelectionnee, Mode=TwoWay}" />
                                <Button
                                    Width="34"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    Background="#33FFFFFF"
                                    BorderThickness="0"
                                    Command="{Binding ChargerCommand}"
                                    Content="&#xE72C;"
                                    Cursor="Hand"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="16"
                                    Foreground="White"
                                    ToolTip="Rafraîchir" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="28,0">
                        <!--  KPI de flux et de performance  -->
                        <WrapPanel>
                            <Border
                                BorderBrush="#FFB300"
                                BorderThickness="0,0,0,4"
                                Style="{StaticResource CarteKpi}">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="#FFB300"
                                        Style="{StaticResource KpiValeur}"
                                        Text="{Binding Kpi.InterventionsActives}" />
                                    <TextBlock Style="{StaticResource KpiLibelle}" Text="Interventions actives" />
                                </StackPanel>
                            </Border>
                            <Border
                                BorderBrush="#FF3B30"
                                BorderThickness="0,0,0,4"
                                Style="{StaticResource CarteKpi}">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="#FF3B30"
                                        Style="{StaticResource KpiValeur}"
                                        Text="{Binding Kpi.PannesAujourdhui}" />
                                    <TextBlock Style="{StaticResource KpiLibelle}" Text="Pannes déclarées aujourd'hui" />
                                </StackPanel>
                            </Border>
                            <Border
                                BorderBrush="#FF3B30"
                                BorderThickness="0,0,0,4"
                                Style="{StaticResource CarteKpi}">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="#FF3B30"
                                        Style="{StaticResource KpiValeur}"
                                        Text="{Binding Kpi.InterventionsUrgentes}" />
                                    <TextBlock Style="{StaticResource KpiLibelle}" Text="Interventions urgentes" />
                                </StackPanel>
                            </Border>
                            <Border
                                BorderBrush="#FF3B30"
                                BorderThickness="0,0,0,4"
                                Style="{StaticResource CarteKpi}">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="#FF3B30"
                                        Style="{StaticResource KpiValeur}"
                                        Text="{Binding Kpi.EnDepassementSla}" />
                                    <TextBlock Style="{StaticResource KpiLibelle}" Text="En dépassement de délai (SLA)" />
                                </StackPanel>
                            </Border>
                            <Border
                                BorderBrush="#29B6F6"
                                BorderThickness="0,0,0,4"
                                Style="{StaticResource CarteKpi}">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="#29B6F6"
                                        Style="{StaticResource KpiValeur}"
                                        Text="{Binding Kpi.MttrHeures, StringFormat={}{0} h}" />
                                    <TextBlock Style="{StaticResource KpiLibelle}" Text="Temps moyen de résolution (MTTR)" />
                                </StackPanel>
                            </Border>
                            <Border
                                BorderBrush="#29B6F6"
                                BorderThickness="0,0,0,4"
                                Style="{StaticResource CarteKpi}">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="#29B6F6"
                                        Style="{StaticResource KpiValeur}"
                                        Text="{Binding Kpi.DelaiMoyenAffectationHeures, StringFormat={}{0} h}" />
                                    <TextBlock Style="{StaticResource KpiLibelle}" Text="Délai moyen d'affectation" />
                                </StackPanel>
                            </Border>
                            <Border
                                BorderBrush="#00E676"
                                BorderThickness="0,0,0,4"
                                Style="{StaticResource CarteKpi}">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="#00E676"
                                        Style="{StaticResource KpiValeur}"
                                        Text="{Binding Kpi.InterventionsCloturees}" />
                                    <TextBlock Style="{StaticResource KpiLibelle}" Text="Clôturées sur la période" />
                                </StackPanel>
                            </Border>
                            <Border
                                BorderBrush="#90A4AE"
                                BorderThickness="0,0,0,4"
                                Style="{StaticResource CarteKpi}">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="#90A4AE"
                                        Style="{StaticResource KpiValeur}"
                                        Text="{Binding Kpi.CoutCumule, StringFormat={}{0:N0} MAD}" />
                                    <TextBlock Style="{StaticResource KpiLibelle}" Text="Coût cumulé (période)" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!--  KPI parc / disponibilité : vue globale uniquement  -->
                        <StackPanel Visibility="{Binding VueGlobale, Converter={StaticResource BoolVisib}}">
                            <TextBlock
                                Margin="0,6,0,14"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PinceauTexteHud}"
                                Text="Parc &amp; disponibilité" />
                            <WrapPanel>
                                <Border
                                    BorderBrush="#29B6F6"
                                    BorderThickness="0,0,0,4"
                                    Style="{StaticResource CarteKpi}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="#29B6F6"
                                            Style="{StaticResource KpiValeur}"
                                            Text="{Binding Kpi.DisponibiliteGlobale, StringFormat={}{0} %}" />
                                        <TextBlock Style="{StaticResource KpiLibelle}" Text="Disponibilité des respirateurs" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    BorderBrush="#90A4AE"
                                    BorderThickness="0,0,0,4"
                                    Style="{StaticResource CarteKpi}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource KpiValeur}" Text="{Binding Kpi.NombreRespirateurs}" />
                                        <TextBlock Style="{StaticResource KpiLibelle}" Text="Respirateurs au parc" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    BorderBrush="#00E676"
                                    BorderThickness="0,0,0,4"
                                    Style="{StaticResource CarteKpi}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="#00E676"
                                            Style="{StaticResource KpiValeur}"
                                            Text="{Binding Kpi.RespirateursEnService}" />
                                        <TextBlock Style="{StaticResource KpiLibelle}" Text="En service" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    BorderBrush="#FF3B30"
                                    BorderThickness="0,0,0,4"
                                    Style="{StaticResource CarteKpi}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="#FF3B30"
                                            Style="{StaticResource KpiValeur}"
                                            Text="{Binding Kpi.RespirateursHorsService}" />
                                        <TextBlock Style="{StaticResource KpiLibelle}" Text="Hors service" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    BorderBrush="#FFB300"
                                    BorderThickness="0,0,0,4"
                                    Style="{StaticResource CarteKpi}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="#FFB300"
                                            Style="{StaticResource KpiValeur}"
                                            Text="{Binding Kpi.PiecesEnAlerte}" />
                                        <TextBlock Style="{StaticResource KpiLibelle}" Text="Pièces en alerte de stock" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <!--  Graphiques BI  -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Margin="0,0,9,0"
                                Style="{StaticResource CartePanneau}">
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Top"
                                        Style="{StaticResource TitrePanneau}"
                                        Text="Répartition des interventions par état" />
                                    <lvc:PieChart
                                        Height="250"
                                        LegendPosition="Right"
                                        Series="{Binding SeriesEtats}" />
                                </DockPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Margin="9,0,0,0"
                                Style="{StaticResource CartePanneau}">
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Top"
                                        Style="{StaticResource TitrePanneau}"
                                        Text="Interventions par modèle" />
                                    <lvc:CartesianChart
                                        Height="250"
                                        Series="{Binding SeriesModeles}"
                                        XAxes="{Binding AxesModeles}" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!--  Top 5 respirateurs + Top 5 hôpitaux  -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Margin="0,0,9,0"
                                Style="{StaticResource CartePanneau}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TitrePanneau}" Text="Top 5 des respirateurs les plus défaillants" />
                                    <ItemsControl ItemTemplate="{StaticResource LigneClassement}" ItemsSource="{Binding Top5Respirateurs}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Margin="9,0,0,0"
                                Style="{StaticResource CartePanneau}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TitrePanneau}" Text="Top 5 des hôpitaux" />
                                    <ItemsControl ItemTemplate="{StaticResource LigneClassement}" ItemsSource="{Binding Top5Hopitaux}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  Pareto pannes + disponibilité par équipement  -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Margin="0,0,9,0"
                                Style="{StaticResource CartePanneau}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TitrePanneau}" Text="Pareto des pannes récurrentes" />
                                    <ItemsControl ItemTemplate="{StaticResource LigneClassement}" ItemsSource="{Binding ParetoPannes}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Margin="9,0,0,0"
                                Style="{StaticResource CartePanneau}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TitrePanneau}" Text="Disponibilité par équipement (%)" />
                                    <ItemsControl ItemsSource="{Binding DisponibiliteParEquipement}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel
                                                        Grid.Column="0"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="13"
                                                            Foreground="{StaticResource PinceauTexteHud}"
                                                            Text="{Binding Libelle}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Border
                                                            Width="{Binding LargeurBarre}"
                                                            Height="6"
                                                            Margin="0,4,0,0"
                                                            HorizontalAlignment="Left"
                                                            Background="{Binding Couleur}"
                                                            CornerRadius="3" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource PinceauTexteHud}"
                                                        Text="{Binding Pourcentage, StringFormat={}{0} %}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  Charge par technicien  -->
                        <Border Margin="0,18,0,0" Style="{StaticResource CartePanneau}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TitrePanneau}" Text="Charge par technicien" />
                                <Grid Margin="0,0,0,6">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#90A4AE"
                                        Text="Technicien" />
                                    <TextBlock
                                        Margin="0,0,70,0"
                                        HorizontalAlignment="Right"
                                        FontSize="11"
                                        Foreground="#90A4AE"
                                        Text="En cours" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="11"
                                        Foreground="#90A4AE"
                                        Text="Terminées" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ChargeParTechnicien}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="#90A4AE"
                                                    Text="{Binding Nom}" />
                                                <TextBlock
                                                    Margin="0,0,70,0"
                                                    HorizontalAlignment="Right"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="#FFB300"
                                                    Text="{Binding EnCours}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="#00E676"
                                                    Text="{Binding Terminees}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <!--
            Vue « Analytique » : statistiques avancées (ancien module Statistiques).
            Résolue via le DataTemplate VM→View habituel, sans duplication de contenu.
        -->
        <TabItem Header="Analytique">
            <ContentControl Content="{Binding Statistiques}" />
        </TabItem>
    </TabControl>
</UserControl>
