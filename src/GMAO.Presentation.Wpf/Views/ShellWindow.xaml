<Window x:Class="GMAO.Presentation.Wpf.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GMAO Datex-Ohmeda — MEDICANA"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Style des éléments de navigation -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#CFD8DC"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bord" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bord" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bord" Property="Background" Value="#1F4FC3F7"/>
                                <Setter TargetName="Bord" Property="BorderBrush" Value="#4FC3F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Border Grid.Column="0" Background="#1B2A33">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="20,24,20,16">
                    <TextBlock Text="GMAO" Foreground="#4FC3F7" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Datex-Ohmeda · MEDICANA" Foreground="#78909C" FontSize="12"/>
                </StackPanel>

                <!-- Menu -->
                <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icone}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="18" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Titre}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Profil + déconnexion -->
                <Border Grid.Row="2" BorderBrush="#2C3E48" BorderThickness="0,1,0,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#2C5364">
                            <TextBlock Text="{Binding Initiales}" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UtilisateurNom}" Foreground="#ECEFF1" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding UtilisateurRole}" Foreground="#78909C" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="&#xE7E8;" ToolTip="Se déconnecter"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                Foreground="#90A4AE" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Command="{Binding DeconnexionCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Zone de contenu -->
        <Grid Grid.Column="1" Background="#F4F6F8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E0E4E8" BorderThickness="0,0,0,1" Padding="28,14">
                <Grid>
                    <TextBlock Text="{Binding SelectedNav.Titre}" FontSize="20" FontWeight="SemiBold" Foreground="#203A43" VerticalAlignment="Center"/>

                    <!-- Cloche de notifications -->
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BoutonCloche" Width="40" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Command="{Binding BasculerNotificationsCommand}"
                                Content="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="#546E7A"/>
                        <Border Background="#C62828" CornerRadius="9" MinWidth="18" Height="18" Padding="4,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NombreNotifications}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding NombreNotifications}" Foreground="White" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Popup IsOpen="{Binding PanneauNotificationsOuvert}" PlacementTarget="{Binding ElementName=BoutonCloche}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="White" CornerRadius="10" Width="360" Margin="8" BorderBrush="#E0E4E8" BorderThickness="1">
                                <Border.Effect><DropShadowEffect Color="#33000000" BlurRadius="18" ShadowDepth="3" Direction="270"/></Border.Effect>
                                <DockPanel Margin="14">
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="15" Foreground="#203A43"/>
                                        <Button Content="Tout effacer" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                                Foreground="#0277BD" Cursor="Hand" FontSize="12" Command="{Binding EffacerNotificationsCommand}"/>
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Top" Text="Aucune notification" Foreground="#90A4AE" FontSize="12" Margin="0,8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NombreNotifications}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
                                        <ItemsControl ItemsSource="{Binding Notifications}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F4F6F8" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" Foreground="#263238" FontSize="13"/>
                                                            <TextBlock Text="{Binding Message}" Foreground="#546E7A" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding Date, StringFormat=HH:mm:ss}" Foreground="#B0BEC5" FontSize="10" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="0"/>
        </Grid>
    </Grid>
</Window>
