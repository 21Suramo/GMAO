<local:FluentWindowBase
    x:Class="GMAO.Presentation.Wpf.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GMAO.Presentation.Wpf.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="GMAO Datex-Ohmeda — MEDICANA"
    Width="1180"
    Height="720"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">
    <local:FluentWindowBase.Resources>
        <!--  Style des éléments de navigation  -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#CFD8DC" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Bord"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bord" Property="Background" Value="#15FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bord" Property="Background" Value="#1F00E5A8" />
                                <Setter TargetName="Bord" Property="BorderBrush" Value="#00E5A8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:FluentWindowBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!--  Bandeau caption (boutons fenêtre + glisser)  -->
            <RowDefinition Height="32" />
            <!--  Bande d'état globale  -->
            <RowDefinition Height="Auto" />
            <!--  Zone principale : rail compact + contenu  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Fond sombre derrière la zone caption, pour la continuité visuelle avec la bande d'état  -->
        <Border Grid.Row="0" Background="{StaticResource PinceauFondHud}" />

        <!--  Bande d'état globale : statut connexion + compteur critiques + notifications  -->
        <local:BandeEtatGlobale Grid.Row="1" />

        <!--
            Zone principale : le NavigationView (rail compact, icônes seules) occupe toute
            la largeur ; son frame de contenu vide, à droite, est recouvert par la zone de
            contenu ci-dessous, décalée de la largeur du rail compact (56).
            Items peuplés en code-behind depuis ShellViewModel.MenuItems/FooterItems (RBAC déjà appliqué).
        -->
        <Grid Grid.Row="2">
            <local:NavigationViewBase
                x:Name="Nav"
                Background="#1B2A33"
                CompactPaneLength="56"
                IsBackButtonVisible="Collapsed"
                IsPaneOpen="False"
                IsPaneToggleVisible="False"
                PaneDisplayMode="Left"
                Style="{StaticResource {x:Type ui:NavigationView}}">
                <local:NavigationViewBase.PaneHeader>
                    <!--  Logo compact centré (rail = 56 px)  -->
                    <Border
                        Width="38"
                        Height="38"
                        Margin="0,14,0,10"
                        HorizontalAlignment="Center"
                        Background="#1F00E5A8"
                        BorderBrush="{StaticResource PinceauAccentVert}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ToolTip="GMAO — Datex-Ohmeda · MEDICANA">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="{StaticResource PinceauAccentVert}"
                            Text="G" />
                    </Border>
                </local:NavigationViewBase.PaneHeader>
                <local:NavigationViewBase.PaneFooter>
                    <!--  Profil compact (avatar + déconnexion), infos détaillées dans la bande d'état  -->
                    <StackPanel Margin="0,8,0,12" HorizontalAlignment="Center">
                        <Border
                            Width="38"
                            Height="38"
                            Background="#2C5364"
                            CornerRadius="19"
                            ToolTip="{Binding UtilisateurNom}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding Initiales}" />
                        </Border>
                        <Button
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding DeconnexionCommand}"
                            Content="&#xE7E8;"
                            Cursor="Hand"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="16"
                            Foreground="#90A4AE"
                            ToolTip="Se déconnecter" />
                    </StackPanel>
                </local:NavigationViewBase.PaneFooter>
            </local:NavigationViewBase>

            <!--  Zone de contenu : superposée à droite du rail compact (largeur = 56)  -->
            <Grid Margin="56,0,0,0" Background="#F4F6F8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="28,14"
                    BorderBrush="#E0E4E8"
                    BorderThickness="0,0,0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="White" />
                            <Style.Triggers>
                                <!--  En-tête sombre quand la vue active est HUD (désormais tous les modules)  -->
                                <DataTrigger Binding="{Binding EnteteSombre}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PinceauFondHud}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding SelectedNav.Titre}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#203A43" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EnteteSombre}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource PinceauTexteHud}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <ContentControl
                    Grid.Row="1"
                    Margin="0"
                    Content="{Binding CurrentViewModel}" />
            </Grid>
        </Grid>

        <!--
            Barre de titre Fluent : restaure réduire/agrandir/fermer + zone de glisser,
            sur la ligne caption (transparente au-dessus du fond sombre).
        -->
        <ui:TitleBar
            Title=""
            Grid.Row="0"
            Height="32"
            VerticalAlignment="Top"
            Background="Transparent" />
    </Grid>
</local:FluentWindowBase>
