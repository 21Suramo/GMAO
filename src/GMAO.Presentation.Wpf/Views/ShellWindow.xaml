<local:FluentWindowBase
    x:Class="GMAO.Presentation.Wpf.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GMAO.Presentation.Wpf.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="GMAO Datex-Ohmeda — MEDICANA"
    Width="1180"
    Height="720"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <!--
            Volet de navigation Fluent (WPF-UI). Les entrées sont construites dans le
            code-behind à partir de ShellViewModel.MenuItems / FooterItems, déjà filtrées
            par le RBAC. Elles n'ont volontairement pas de TargetPageType : le contenu du
            ContentFrame reste piloté par CurrentViewModel et résolu par les DataTemplates
            VM -> Vue d'App.xaml (voir ShellWindow.xaml.cs).
            La marge haute de 32 px réserve la place de la barre de titre étendue.
        -->
        <local:NavigationViewBase
            x:Name="Navigation"
            Margin="0,32,0,0"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            OpenPaneLength="248"
            PaneDisplayMode="Left">

            <!--  En-tête du volet : identité applicative  -->
            <local:NavigationViewBase.PaneHeader>
                <StackPanel Margin="16,8,16,12">
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#4FC3F7"
                        Text="GMAO" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#78909C"
                        Text="Datex-Ohmeda · MEDICANA" />
                </StackPanel>
            </local:NavigationViewBase.PaneHeader>

            <!--  Bandeau de contenu : titre du module courant + notifications  -->
            <local:NavigationViewBase.Header>
                <Border
                    Padding="28,14"
                    Background="White"
                    BorderBrush="#E0E4E8"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="#203A43"
                            Text="{Binding SelectedNav.Titre, Mode=OneWay}" />

                        <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button
                                x:Name="BoutonCloche"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding BasculerNotificationsCommand}"
                                Content="&#xEA8F;"
                                Cursor="Hand"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="#546E7A" />
                            <Border
                                Height="18"
                                MinWidth="18"
                                Margin="0,2,2,0"
                                Padding="4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#C62828"
                                CornerRadius="9">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NombreNotifications}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding NombreNotifications, Mode=OneWay}" />
                            </Border>

                            <Popup
                                AllowsTransparency="True"
                                IsOpen="{Binding PanneauNotificationsOuvert}"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=BoutonCloche}"
                                PopupAnimation="Fade"
                                StaysOpen="False">
                                <Border
                                    Width="360"
                                    Margin="8"
                                    Background="White"
                                    BorderBrush="#E0E4E8"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="18"
                                            Direction="270"
                                            ShadowDepth="3"
                                            Color="#33000000" />
                                    </Border.Effect>
                                    <DockPanel Margin="14">
                                        <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="#203A43"
                                                Text="Notifications" />
                                            <Button
                                                HorizontalAlignment="Right"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding EffacerNotificationsCommand}"
                                                Content="Tout effacer"
                                                Cursor="Hand"
                                                FontSize="12"
                                                Foreground="#0277BD" />
                                        </Grid>
                                        <TextBlock
                                            Margin="0,8"
                                            DockPanel.Dock="Top"
                                            FontSize="12"
                                            Foreground="#90A4AE"
                                            Text="Aucune notification">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NombreNotifications}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Notifications}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Margin="0,0,0,6"
                                                            Padding="10"
                                                            Background="#F4F6F8"
                                                            CornerRadius="8">
                                                            <StackPanel>
                                                                <TextBlock
                                                                    FontSize="13"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="#263238"
                                                                    Text="{Binding Titre}" />
                                                                <TextBlock
                                                                    Margin="0,2,0,0"
                                                                    FontSize="12"
                                                                    Foreground="#546E7A"
                                                                    Text="{Binding Message}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    Margin="0,4,0,0"
                                                                    FontSize="10"
                                                                    Foreground="#B0BEC5"
                                                                    Text="{Binding Date, StringFormat=HH:mm:ss}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>
            </local:NavigationViewBase.Header>

            <!--  Pied du volet : profil de l'utilisateur connecté + déconnexion  -->
            <local:NavigationViewBase.PaneFooter>
                <Border
                    Padding="16,14"
                    BorderBrush="#2C3E48"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            Background="#2C5364"
                            CornerRadius="20">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding Initiales, Mode=OneWay}" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#ECEFF1"
                                Text="{Binding UtilisateurNom, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="#78909C"
                                Text="{Binding UtilisateurRole, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding DeconnexionCommand}"
                            Content="&#xE7E8;"
                            Cursor="Hand"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="16"
                            Foreground="#90A4AE"
                            ToolTip="Se déconnecter" />
                    </Grid>
                </Border>
            </local:NavigationViewBase.PaneFooter>
        </local:NavigationViewBase>

        <!--
            Barre de titre Fluent : réduire / agrandir / fermer + zone de glisser,
            en overlay transparent pour conserver le rendu bord à bord.
        -->
        <ui:TitleBar
            Title=""
            Height="32"
            VerticalAlignment="Top"
            Background="Transparent" />
    </Grid>
</local:FluentWindowBase>
