<UserControl
    x:Class="GMAO.Presentation.Wpf.Views.StatistiquesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:GMAO.Presentation.Wpf.Converters"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:StringVersVisibiliteConverter x:Key="StrVisib" />
        <Style x:Key="CartePanneau" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="16"
                        Direction="270"
                        ShadowDepth="3"
                        Color="#1E000000" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitrePanneau" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#203A43" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <!--  Bannière  -->
            <Border Margin="0,0,0,22" Padding="28,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#4A148C" />
                        <GradientStop Offset="1" Color="#6A1B9A" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Statistiques avancées" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="13"
                            Foreground="#E1BEE7"
                            Text="{Binding PeriodeLibelle}" />
                    </StackPanel>
                    <Button
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#33FFFFFF"
                        BorderThickness="0"
                        Command="{Binding ChargerCommand}"
                        Content="&#xE72C;"
                        Cursor="Hand"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="16"
                        Foreground="White"
                        ToolTip="Rafraîchir" />
                </Grid>
            </Border>

            <StackPanel Margin="28,0">
                <Border
                    Margin="0,0,0,16"
                    Padding="12"
                    Background="#FFEBEE"
                    CornerRadius="8"
                    Visibility="{Binding Message, Converter={StaticResource StrVisib}}">
                    <TextBlock
                        Foreground="#C62828"
                        Text="{Binding Message}"
                        TextWrapping="Wrap" />
                </Border>

                <!--  1. Évolution des pannes par mois  -->
                <Border Margin="0,0,0,18" Style="{StaticResource CartePanneau}">
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Top"
                            Style="{StaticResource TitrePanneau}"
                            Text="Évolution des pannes par mois" />
                        <lvc:CartesianChart
                            Height="260"
                            Series="{Binding SeriesPannes}"
                            XAxes="{Binding AxesPannes}" />
                    </DockPanel>
                </Border>

                <!--  2. Coût mensuel des interventions  -->
                <Border Margin="0,0,0,18" Style="{StaticResource CartePanneau}">
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Top"
                            Style="{StaticResource TitrePanneau}"
                            Text="Coût mensuel des interventions (MAD)" />
                        <lvc:CartesianChart
                            Height="260"
                            Series="{Binding SeriesCout}"
                            XAxes="{Binding AxesCout}" />
                    </DockPanel>
                </Border>

                <!--  3. Disponibilité par hôpital + 4. Durée par ingénieur  -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Margin="0,0,9,0"
                        Style="{StaticResource CartePanneau}">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Top"
                                Style="{StaticResource TitrePanneau}"
                                Text="Disponibilité par hôpital (%)" />
                            <lvc:CartesianChart
                                Height="260"
                                Series="{Binding SeriesDispoHopital}"
                                XAxes="{Binding AxesDispoHopital}" />
                        </DockPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Margin="9,0,0,0"
                        Style="{StaticResource CartePanneau}">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Top"
                                Style="{StaticResource TitrePanneau}"
                                Text="Durée moyenne d'intervention par ingénieur (h)" />
                            <lvc:CartesianChart
                                Height="260"
                                Series="{Binding SeriesDuree}"
                                XAxes="{Binding AxesDuree}" />
                        </DockPanel>
                    </Border>
                </Grid>

                <!--  5. Comparaison entre modèles : graphique + tableau  -->
                <Border Style="{StaticResource CartePanneau}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitrePanneau}" Text="Comparaison entre modèles de respirateurs" />
                        <lvc:CartesianChart
                            Height="240"
                            Series="{Binding SeriesModeles}"
                            XAxes="{Binding AxesModeles}" />

                        <Grid Margin="0,14,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                FontSize="11"
                                Foreground="#90A4AE"
                                Text="Modèle" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="11"
                                Foreground="#90A4AE"
                                Text="Interventions" />
                            <TextBlock
                                Grid.Column="2"
                                FontSize="11"
                                Foreground="#90A4AE"
                                Text="MTTR (h)" />
                            <TextBlock
                                Grid.Column="3"
                                FontSize="11"
                                Foreground="#90A4AE"
                                Text="Coût moyen (MAD)" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ComparaisonModeles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#37474F"
                                            Text="{Binding Modele}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="13"
                                            Foreground="#00838F"
                                            Text="{Binding NombreInterventions}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            FontSize="13"
                                            Foreground="#546E7A"
                                            Text="{Binding MttrHeures}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            FontSize="13"
                                            Foreground="#546E7A"
                                            Text="{Binding CoutMoyen, StringFormat={}{0:N0}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
