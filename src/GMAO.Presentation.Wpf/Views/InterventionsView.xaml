<UserControl
    x:Class="GMAO.Presentation.Wpf.Views.InterventionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:GMAO.Presentation.Wpf.Converters"
    FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:EtatInterventionVersCouleurConverter x:Key="EtatCouleur" />
        <conv:PrioriteVersCouleurConverter x:Key="PrioCouleur" />
        <conv:NullVersVisibiliteConverter x:Key="NullVisib" />
        <conv:BoolVersVisibiliteConverter x:Key="BoolVisib" />
        <conv:StringVersVisibiliteConverter x:Key="StrVisib" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>

        <!--  Colonne liste / création  -->
        <Border
            Grid.Column="0"
            Padding="6"
            Background="White"
            CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    ShadowDepth="2"
                    Color="#22000000" />
            </Border.Effect>
            <DockPanel>
                <Grid Margin="14,12,14,8" DockPanel.Dock="Top">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#203A43"
                        Text="Interventions" />
                    <Button
                        Padding="12,5"
                        HorizontalAlignment="Right"
                        Background="#2C5364"
                        BorderThickness="0"
                        Command="{Binding BasculerCreationCommand}"
                        Content="+ Nouvelle DI"
                        Cursor="Hand"
                        Foreground="White" />
                </Grid>

                <!--  Formulaire de déclaration  -->
                <Border
                    Margin="10,0,10,8"
                    Padding="14"
                    Background="#ECF3F7"
                    CornerRadius="10"
                    DockPanel.Dock="Top"
                    Visibility="{Binding CreationVisible, Converter={StaticResource BoolVisib}}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Foreground="#203A43"
                            Text="Déclarer une intervention" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#546E7A"
                            Text="Respirateur" />
                        <ComboBox
                            Height="32"
                            Margin="0,2,0,8"
                            DisplayMemberPath="NumeroSerie"
                            ItemsSource="{Binding Respirateurs}"
                            SelectedItem="{Binding NouveauRespirateur}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#546E7A"
                            Text="Description de la panne" />
                        <TextBox
                            Height="48"
                            Margin="0,2,0,8"
                            Padding="6"
                            AcceptsReturn="True"
                            Text="{Binding NouvelleDescription, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#546E7A"
                            Text="Priorité" />
                        <ComboBox
                            Height="32"
                            Margin="0,2,0,8"
                            ItemsSource="{Binding Priorites}"
                            SelectedItem="{Binding NouvellePriorite}" />
                        <CheckBox
                            Margin="0,2,0,8"
                            Content="Patient connecté (déclenche une DI critique)"
                            FontWeight="SemiBold"
                            Foreground="#C62828"
                            IsChecked="{Binding NouveauPatientConnecte}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#546E7A"
                            Text="Symptômes" />
                        <ItemsControl Margin="0,2,0,8" ItemsSource="{Binding Symptomes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="0,2"
                                        Content="{Binding Libelle}"
                                        IsChecked="{Binding Selectionne}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            Padding="14,7"
                            HorizontalAlignment="Left"
                            Background="#2E7D32"
                            BorderThickness="0"
                            Command="{Binding CreerCommand}"
                            Content="Créer la DI"
                            Cursor="Hand"
                            Foreground="White" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="#C62828"
                            Text="{Binding Message}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Message, Converter={StaticResource StrVisib}}" />
                    </StackPanel>
                </Border>

                <ListView
                    BorderThickness="0"
                    ItemsSource="{Binding Interventions}"
                    SelectedItem="{Binding Selection, Mode=TwoWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="2"
                                Padding="10"
                                CornerRadius="8">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="#263238"
                                            Text="{Binding NumeroDI}" />
                                        <Border
                                            Padding="8,2"
                                            HorizontalAlignment="Right"
                                            Background="{Binding Priorite, Converter={StaticResource PrioCouleur}}"
                                            CornerRadius="9">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding PrioriteLibelle}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Margin="0,3,0,4"
                                        FontSize="12"
                                        Foreground="#546E7A"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Grid>
                                        <Border
                                            Padding="8,2"
                                            HorizontalAlignment="Left"
                                            Background="{Binding Etat, Converter={StaticResource EtatCouleur}}"
                                            CornerRadius="9">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding EtatLibelle}" />
                                        </Border>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="#90A4AE"
                                            Text="{Binding RespirateurSerie}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>

        <!--  Colonne détail  -->
        <Border
            Grid.Column="2"
            Padding="22"
            Background="White"
            CornerRadius="12"
            Visibility="{Binding Detail, Converter={StaticResource NullVisib}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    ShadowDepth="2"
                    Color="#22000000" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="#203A43"
                                Text="{Binding Detail.NumeroDI}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="#546E7A"
                                Text="{Binding Detail.Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border
                            Padding="10,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{Binding Detail.Etat, Converter={StaticResource EtatCouleur}}"
                            CornerRadius="10">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding Detail.EtatLibelle}" />
                        </Border>
                    </Grid>

                    <!--  Bandeau critique  -->
                    <Border
                        Margin="0,14,0,0"
                        Padding="12"
                        Background="#FFEBEE"
                        CornerRadius="8"
                        Visibility="{Binding Detail.PatientConnecte, Converter={StaticResource BoolVisib}}">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#C62828"
                            TextWrapping="Wrap">
                            <Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7BA;" /><Run Text=" PATIENT CONNECTÉ — intervention critique, priorité maximale" />
                        </TextBlock>
                    </Border>

                    <!--  Fiche  -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,3"
                            Foreground="#78909C"
                            Text="Respirateur" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="12,3"
                            Foreground="#37474F">
                            <Run Text="{Binding Detail.RespirateurSerie}" /><Run Text="  ·  " /><Run Text="{Binding Detail.ModeleNom}" />
                        </TextBlock>
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,3"
                            Foreground="#78909C"
                            Text="Hôpital" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="12,3"
                            Foreground="#37474F"
                            Text="{Binding Detail.HopitalNom}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,3"
                            Foreground="#78909C"
                            Text="Ingénieur" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="12,3"
                            Foreground="#37474F"
                            Text="{Binding Detail.IngenieurNom, TargetNullValue=Non affecté}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,3"
                            Foreground="#78909C"
                            Text="Priorité" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="12,3"
                            Foreground="#37474F"
                            Text="{Binding Detail.PrioriteLibelle}" />
                    </Grid>

                    <!--  Actions workflow  -->
                    <TextBlock
                        Margin="0,18,0,8"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#90A4AE"
                        Text="WORKFLOW" />
                    <WrapPanel>
                        <Button
                            Margin="0,0,8,8"
                            Padding="12,7"
                            Background="#2C5364"
                            BorderThickness="0"
                            Command="{Binding AvancerCommand}"
                            Cursor="Hand"
                            Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Avancer l'étape" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Text="&#xE72A;" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,0,8,8"
                            Padding="12,7"
                            Background="#EF6C00"
                            BorderThickness="0"
                            Command="{Binding MettreEnAttentePieceCommand}"
                            Content="En attente pièce"
                            Cursor="Hand"
                            Foreground="White" />
                        <Button
                            Margin="0,0,8,8"
                            Padding="12,7"
                            Background="#2E7D32"
                            BorderThickness="0"
                            Command="{Binding CloturerCommand}"
                            Cursor="Hand"
                            Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Clôturer" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Text="&#xE930;" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,0,8,8"
                            Padding="12,7"
                            Background="#455A64"
                            BorderThickness="0"
                            Command="{Binding GenererRapportCommand}"
                            Cursor="Hand"
                            Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Text="&#xE7C3;" />
                                <TextBlock VerticalAlignment="Center" Text="Rapport PDF" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!--  Check-list  -->
                    <TextBlock
                        Margin="0,12,0,8"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#90A4AE"
                        Text="CHECK-LIST DE CLÔTURE (obligatoire)" />
                    <Border
                        Padding="14"
                        Background="#F4F6F8"
                        CornerRadius="10">
                        <StackPanel>
                            <CheckBox
                                Margin="0,3"
                                Content="Autotest OK"
                                IsChecked="{Binding CkAutotest}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Test d'étanchéité"
                                IsChecked="{Binding CkEtancheite}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Calibration débit"
                                IsChecked="{Binding CkCalibrationDebit}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Calibration O2"
                                IsChecked="{Binding CkCalibrationO2}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Batterie"
                                IsChecked="{Binding CkBatterie}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Alimentation"
                                IsChecked="{Binding CkAlimentation}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Alarmes"
                                IsChecked="{Binding CkAlarmes}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Validation finale"
                                IsChecked="{Binding CkValidationFinale}" />
                            <Button
                                Margin="0,8,0,0"
                                Padding="12,6"
                                HorizontalAlignment="Left"
                                Background="#455A64"
                                BorderThickness="0"
                                Command="{Binding EnregistrerCheckListCommand}"
                                Content="Enregistrer la check-list"
                                Cursor="Hand"
                                Foreground="White" />
                        </StackPanel>
                    </Border>

                    <!--  Historique  -->
                    <TextBlock
                        Margin="0,18,0,8"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#90A4AE"
                        Text="HISTORIQUE DU WORKFLOW" />
                    <ItemsControl ItemsSource="{Binding Historique}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="#4FC3F7" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        FontSize="12"
                                        Foreground="#546E7A">
                                        <Run FontWeight="SemiBold" Text="{Binding Date, StringFormat=g, Mode=OneWay}" /><Run Text="  —  " /><Run Text="{Binding Libelle, Mode=OneWay}" /><Run Text="  (" /><Run Text="{Binding Auteur, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Margin="0,14,0,0"
                        Foreground="#0277BD"
                        Text="{Binding Message}"
                        TextWrapping="Wrap"
                        Visibility="{Binding Message, Converter={StaticResource StrVisib}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
