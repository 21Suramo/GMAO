<UserControl
    x:Class="GMAO.Presentation.Wpf.Views.InterventionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:GMAO.Presentation.Wpf.Converters"
    Background="{StaticResource PinceauFondHud}"
    FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:EtatInterventionVersCouleurConverter x:Key="EtatCouleur" />
        <conv:PrioriteVersCouleurConverter x:Key="PrioCouleur" />
        <conv:NullVersVisibiliteConverter x:Key="NullVisib" />
        <conv:BoolVersVisibiliteConverter x:Key="BoolVisib" />
        <conv:StringVersVisibiliteConverter x:Key="StrVisib" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>

        <!--  Colonne liste / création  -->
        <Border
            Grid.Column="0"
            Padding="6"
            Background="{StaticResource PinceauSurfaceHud}"
            CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    ShadowDepth="2"
                    Color="#22000000" />
            </Border.Effect>
            <DockPanel>
                <Grid Margin="14,12,14,8" DockPanel.Dock="Top">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PinceauTexteHud}"
                        Text="Interventions" />
                    <Button
                        Padding="12,5"
                        HorizontalAlignment="Right"
                        Background="#2C5364"
                        BorderThickness="0"
                        Command="{Binding BasculerCreationCommand}"
                        Content="+ Nouvelle DI"
                        Cursor="Hand"
                        Foreground="White" />
                </Grid>

                <!--
                    Le formulaire de déclaration est désormais un panneau latéral (overlay col 2), plus bas.
                    La liste occupe donc toute la hauteur en permanence.
                -->
                <ListView
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource LigneCarteHud}"
                    ItemsSource="{Binding Interventions}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding Selection, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="2,3"
                                Background="#14FFFFFF"
                                BorderBrush="{StaticResource PinceauSeparateurHud}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!--  Pastille de priorité (bande verticale colorée)  -->
                                    <Rectangle
                                        Grid.Column="0"
                                        Margin="0,3"
                                        Fill="{Binding Priorite, Converter={StaticResource PrioCouleur}}"
                                        RadiusX="2"
                                        RadiusY="2" />
                                    <StackPanel Grid.Column="1" Margin="12,9">
                                        <Grid>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource PinceauTexteHud}"
                                                Text="{Binding NumeroDI}" />
                                            <Border
                                                Padding="8,2"
                                                HorizontalAlignment="Right"
                                                Background="{Binding Priorite, Converter={StaticResource PrioCouleur}}"
                                                CornerRadius="9">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="{Binding PrioriteLibelle}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            Margin="0,3,0,4"
                                            FontSize="12"
                                            Foreground="{StaticResource PinceauTexteHudSecondaire}"
                                            Text="{Binding Description}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Grid>
                                            <Border
                                                Padding="8,2"
                                                HorizontalAlignment="Left"
                                                Background="{Binding Etat, Converter={StaticResource EtatCouleur}}"
                                                CornerRadius="9">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="{Binding EtatLibelle}" />
                                            </Border>
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#90A4AE"
                                                Text="{Binding RespirateurSerie}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>

        <!--  Colonne détail  -->
        <Border
            Grid.Column="2"
            Padding="22"
            Background="{StaticResource PinceauSurfaceHud}"
            CornerRadius="12"
            Visibility="{Binding Detail, Converter={StaticResource NullVisib}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    ShadowDepth="2"
                    Color="#22000000" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="{StaticResource PinceauTexteHud}"
                                Text="{Binding Detail.NumeroDI}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{StaticResource PinceauTexteHudSecondaire}"
                                Text="{Binding Detail.Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border
                            Padding="10,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{Binding Detail.Etat, Converter={StaticResource EtatCouleur}}"
                            CornerRadius="10">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding Detail.EtatLibelle}" />
                        </Border>
                    </Grid>

                    <!--  Bandeau critique  -->
                    <Border
                        Margin="0,14,0,0"
                        Padding="12"
                        Background="#FFEBEE"
                        CornerRadius="8"
                        Visibility="{Binding Detail.PatientConnecte, Converter={StaticResource BoolVisib}}">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#C62828"
                            TextWrapping="Wrap">
                            <Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7BA;" /><Run Text=" PATIENT CONNECTÉ — intervention critique, priorité maximale" />
                        </TextBlock>
                    </Border>

                    <!--  Fiche  -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,3"
                            Foreground="#78909C"
                            Text="Respirateur" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="12,3"
                            Foreground="{StaticResource PinceauTexteHud}">
                            <Run Text="{Binding Detail.RespirateurSerie}" /><Run Text="  ·  " /><Run Text="{Binding Detail.ModeleNom}" />
                        </TextBlock>
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,3"
                            Foreground="#78909C"
                            Text="Hôpital" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="12,3"
                            Foreground="{StaticResource PinceauTexteHud}"
                            Text="{Binding Detail.HopitalNom}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,3"
                            Foreground="#78909C"
                            Text="Ingénieur" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="12,3"
                            Foreground="{StaticResource PinceauTexteHud}"
                            Text="{Binding Detail.IngenieurNom, TargetNullValue=Non affecté}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,3"
                            Foreground="#78909C"
                            Text="Priorité" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="12,3"
                            Foreground="{StaticResource PinceauTexteHud}"
                            Text="{Binding Detail.PrioriteLibelle}" />
                    </Grid>

                    <!--  Actions workflow  -->
                    <TextBlock
                        Margin="0,18,0,8"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#90A4AE"
                        Text="WORKFLOW" />
                    <WrapPanel>
                        <Button
                            Margin="0,0,8,8"
                            Padding="12,7"
                            Background="#2C5364"
                            BorderThickness="0"
                            Command="{Binding AvancerCommand}"
                            Cursor="Hand"
                            Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Avancer l'étape" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Text="&#xE72A;" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,0,8,8"
                            Padding="12,7"
                            Background="#EF6C00"
                            BorderThickness="0"
                            Command="{Binding MettreEnAttentePieceCommand}"
                            Content="En attente pièce"
                            Cursor="Hand"
                            Foreground="White" />
                        <Button
                            Margin="0,0,8,8"
                            Padding="12,7"
                            Background="#2E7D32"
                            BorderThickness="0"
                            Command="{Binding CloturerCommand}"
                            Cursor="Hand"
                            Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Clôturer" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Text="&#xE930;" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,0,8,8"
                            Padding="12,7"
                            Background="#455A64"
                            BorderThickness="0"
                            Command="{Binding GenererRapportCommand}"
                            Cursor="Hand"
                            Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Text="&#xE7C3;" />
                                <TextBlock VerticalAlignment="Center" Text="Rapport PDF" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!--  Check-list  -->
                    <TextBlock
                        Margin="0,12,0,8"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#90A4AE"
                        Text="CHECK-LIST DE CLÔTURE (obligatoire)" />
                    <Border
                        Padding="14"
                        Background="{StaticResource PinceauFondHud}"
                        CornerRadius="10">
                        <StackPanel>
                            <CheckBox
                                Margin="0,3"
                                Content="Autotest OK"
                                IsChecked="{Binding CkAutotest}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Test d'étanchéité"
                                IsChecked="{Binding CkEtancheite}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Calibration débit"
                                IsChecked="{Binding CkCalibrationDebit}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Calibration O2"
                                IsChecked="{Binding CkCalibrationO2}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Batterie"
                                IsChecked="{Binding CkBatterie}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Alimentation"
                                IsChecked="{Binding CkAlimentation}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Alarmes"
                                IsChecked="{Binding CkAlarmes}" />
                            <CheckBox
                                Margin="0,3"
                                Content="Validation finale"
                                IsChecked="{Binding CkValidationFinale}" />
                            <Button
                                Margin="0,8,0,0"
                                Padding="12,6"
                                HorizontalAlignment="Left"
                                Background="#455A64"
                                BorderThickness="0"
                                Command="{Binding EnregistrerCheckListCommand}"
                                Content="Enregistrer la check-list"
                                Cursor="Hand"
                                Foreground="White" />
                        </StackPanel>
                    </Border>

                    <!--  Historique  -->
                    <TextBlock
                        Margin="0,18,0,8"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#90A4AE"
                        Text="HISTORIQUE DU WORKFLOW" />
                    <ItemsControl ItemsSource="{Binding Historique}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="#4FC3F7" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource PinceauTexteHudSecondaire}">
                                        <Run FontWeight="SemiBold" Text="{Binding Date, StringFormat=g, Mode=OneWay}" /><Run Text="  —  " /><Run Text="{Binding Libelle, Mode=OneWay}" /><Run Text="  (" /><Run Text="{Binding Auteur, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Margin="0,14,0,0"
                        Foreground="#0277BD"
                        Text="{Binding Message}"
                        TextWrapping="Wrap"
                        Visibility="{Binding Message, Converter={StaticResource StrVisib}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Scrim : assombrit le détail derrière le panneau de création ; la liste (col 0) reste pleinement visible.  -->
        <Border
            Grid.Column="2"
            Background="#B3000000"
            Visibility="{Binding CreationVisible, Converter={StaticResource BoolVisib}}" />

        <!--  Panneau latéral de création (overlay, largeur fixe 400px)  -->
        <Border
            Grid.Column="2"
            Width="400"
            HorizontalAlignment="Right"
            Background="{StaticResource PinceauSurfaceHud}"
            BorderBrush="{StaticResource PinceauSurfaceHudBordure}"
            BorderThickness="1,0,0,0"
            CornerRadius="12,0,0,12"
            Visibility="{Binding CreationVisible, Converter={StaticResource BoolVisib}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="20"
                    ShadowDepth="0"
                    Color="#66000000" />
            </Border.Effect>
            <ScrollViewer Padding="18" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PinceauTexteHud}"
                            Text="Déclarer une intervention" />
                        <Button
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding BasculerCreationCommand}"
                            Content="&#xE711;"
                            Cursor="Hand"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Foreground="{StaticResource PinceauTexteHudSecondaire}"
                            ToolTip="Fermer" />
                    </Grid>
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource PinceauTexteHudSecondaire}"
                        Text="Respirateur" />
                    <ComboBox
                        Height="32"
                        Margin="0,2,0,8"
                        DisplayMemberPath="NumeroSerie"
                        ItemsSource="{Binding Respirateurs}"
                        SelectedItem="{Binding NouveauRespirateur}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource PinceauTexteHudSecondaire}"
                        Text="Description de la panne" />
                    <TextBox
                        MinHeight="60"
                        MaxHeight="150"
                        Margin="0,2,0,8"
                        Padding="6"
                        AcceptsReturn="True"
                        Text="{Binding NouvelleDescription, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource PinceauTexteHudSecondaire}"
                        Text="Priorité" />
                    <ComboBox
                        Height="32"
                        Margin="0,2,0,8"
                        ItemsSource="{Binding Priorites}"
                        SelectedItem="{Binding NouvellePriorite}" />
                    <CheckBox
                        Margin="0,2,0,8"
                        Content="Patient connecté (déclenche une DI critique)"
                        FontWeight="SemiBold"
                        Foreground="#FF8A80"
                        IsChecked="{Binding NouveauPatientConnecte}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource PinceauTexteHudSecondaire}"
                        Text="Symptômes" />
                    <ItemsControl Margin="0,2,0,8" ItemsSource="{Binding Symptomes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Margin="0,2"
                                    Content="{Binding Libelle}"
                                    IsChecked="{Binding Selectionne}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        Padding="14,7"
                        HorizontalAlignment="Left"
                        Background="#2E7D32"
                        BorderThickness="0"
                        Command="{Binding CreerCommand}"
                        Content="Créer la DI"
                        Cursor="Hand"
                        Foreground="White" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="#FF8A80"
                        Text="{Binding Message}"
                        TextWrapping="Wrap"
                        Visibility="{Binding Message, Converter={StaticResource StrVisib}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
