<UserControl x:Class="GMAO.Presentation.Wpf.Views.EnConstructionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
            <TextBlock Text="{Binding Icone}"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="64" Foreground="#90A4AE"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Titre}" FontSize="24" FontWeight="SemiBold"
                       Foreground="#37474F" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock Text="{Binding Description}" FontSize="14" Foreground="#78909C"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Border Background="#FFF3E0" CornerRadius="20" Padding="16,8" Margin="0,22,0,0" HorizontalAlignment="Center">
                <TextBlock Text="Module à venir" Foreground="#EF6C00" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
