<UserControl
    x:Class="GMAO.Presentation.Wpf.Views.UtilisateurFormulaireDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:GMAO.Presentation.Wpf.Converters">
    <UserControl.Resources>
        <conv:StringVersVisibiliteConverter x:Key="StrVisib" />
        <conv:BoolInverseConverter x:Key="BoolInv" />
        <Style
            x:Key="Champ"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Cle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#78909C" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <StackPanel Width="360">
        <TextBlock Style="{StaticResource Cle}" Text="Login" />
        <TextBox
            IsEnabled="{Binding EstCreation}"
            Style="{StaticResource Champ}"
            Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Cle}" Text="Prénom" />
        <TextBox Style="{StaticResource Champ}" Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Cle}" Text="Nom" />
        <TextBox Style="{StaticResource Champ}" Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Cle}" Text="E-mail" />
        <TextBox Style="{StaticResource Champ}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Cle}" Text="Téléphone" />
        <TextBox Style="{StaticResource Champ}" Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Cle}" Text="Rôle" />
        <ComboBox
            Height="34"
            Margin="0,0,0,10"
            VerticalContentAlignment="Center"
            DisplayMemberPath="Libelle"
            ItemsSource="{Binding Roles}"
            SelectedValue="{Binding Role, Mode=TwoWay}"
            SelectedValuePath="Role" />

        <TextBlock Style="{StaticResource Cle}" Text="Mot de passe" />
        <PasswordBox
            x:Name="PbMotDePasse"
            Height="34"
            Margin="0,0,0,4"
            Padding="8,0"
            VerticalContentAlignment="Center"
            Background="#0E141B"
            BorderBrush="#2E3A44"
            Foreground="{StaticResource PinceauTexteHud}" />
        <TextBlock
            Margin="0,0,0,12"
            FontSize="11"
            Foreground="#B0BEC5"
            Text="Min. 8 caractères, 1 majuscule, 1 minuscule, 1 chiffre."
            TextWrapping="Wrap" />

        <Button
            Padding="12,7"
            HorizontalAlignment="Left"
            Background="{StaticResource PinceauChipHud}"
            BorderThickness="0"
            Command="{Binding ReinitialiserMotDePasseCommand}"
            Content="Réinitialiser le mot de passe"
            Cursor="Hand"
            Foreground="{StaticResource PinceauTexteHud}"
            IsEnabled="{Binding EstCreation, Converter={StaticResource BoolInv}}" />

        <Border
            Margin="0,14,0,0"
            Padding="10"
            CornerRadius="8"
            Visibility="{Binding Message, Converter={StaticResource StrVisib}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1A29B6F6" />
                    <Setter Property="BorderBrush" Value="#3329B6F6" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MessageEstErreur}" Value="True">
                            <Setter Property="Background" Value="#22FF3B30" />
                            <Setter Property="BorderBrush" Value="#66FF3B30" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                Foreground="{StaticResource PinceauTexteHud}"
                Text="{Binding Message}"
                TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
