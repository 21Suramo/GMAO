<UserControl
    x:Class="GMAO.Presentation.Wpf.Views.BandeEtatGlobale"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="34"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <!--
        Bande d'état globale « Moniteur Clinique » : pleine largeur, sous le TitleBar, au-dessus du rail.
        DataContext hérité = ShellViewModel. Trois zones : statut de connexion (gauche),
        compteur d'interventions critiques (centre-droit, rouge + point pulsant si > 0),
        cloche de notifications (droite, déplacée depuis l'en-tête par-écran).
    -->
    <Border
        Height="34"
        Padding="16,0"
        Background="{StaticResource PinceauSurfaceHud}"
        BorderBrush="{StaticResource PinceauSeparateurHud}"
        BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  ===== Statut de connexion =====  -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Ellipse
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center"
                    Fill="{StaticResource PinceauAccentVert}" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Code, Consolas, Courier New"
                    FontSize="12"
                    Foreground="{StaticResource PinceauTexteHud}"
                    Text="{Binding UtilisateurNom}" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Code, Consolas, Courier New"
                    FontSize="12"
                    Foreground="{StaticResource PinceauTexteHudSecondaire}"
                    Text="{Binding UtilisateurRole}" />
            </StackPanel>

            <!--  ===== Compteur d'interventions critiques =====  -->
            <StackPanel
                Grid.Column="2"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  Point pulsant visible uniquement quand une alerte critique est active  -->
                <Ellipse
                    Width="10"
                    Height="10"
                    VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style BasedOn="{StaticResource PointStatutPulsant}" TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource PinceauErreur}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ADesInterventionsCritiques}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Code, Consolas, Courier New"
                    FontSize="12">
                    <Run Text="{Binding InterventionsCritiques, Mode=OneWay}" />
                    <Run Text=" CRITIQUES EN COURS" />
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource PinceauTexteHudSecondaire}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ADesInterventionsCritiques}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PinceauErreur}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!--  Séparateur fin avant la cloche  -->
            <Rectangle
                Grid.Column="3"
                Width="1"
                Margin="0,8"
                Fill="{StaticResource PinceauSeparateurHud}" />

            <!--  ===== Cloche de notifications (déplacée depuis l'en-tête par-écran) =====  -->
            <Grid Grid.Column="4" Margin="8,0,0,0">
                <Button
                    x:Name="BoutonCloche"
                    Width="34"
                    Height="34"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding BasculerNotificationsCommand}"
                    Content="&#xEA8F;"
                    Cursor="Hand"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="18"
                    Foreground="{StaticResource PinceauTexteHudSecondaire}"
                    ToolTip="Notifications" />
                <Border
                    Height="16"
                    MinWidth="16"
                    Margin="0,3,3,0"
                    Padding="4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{StaticResource PinceauErreur}"
                    CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NombreNotifications}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding NombreNotifications}" />
                </Border>

                <Popup
                    AllowsTransparency="True"
                    IsOpen="{Binding PanneauNotificationsOuvert}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=BoutonCloche}"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <Border
                        Width="360"
                        Margin="8"
                        Background="White"
                        BorderBrush="#E0E4E8"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="18"
                                Direction="270"
                                ShadowDepth="3"
                                Color="#33000000" />
                        </Border.Effect>
                        <DockPanel Margin="14">
                            <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#203A43"
                                    Text="Notifications" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding EffacerNotificationsCommand}"
                                    Content="Tout effacer"
                                    Cursor="Hand"
                                    FontSize="12"
                                    Foreground="#0277BD" />
                            </Grid>
                            <TextBlock
                                Margin="0,8"
                                DockPanel.Dock="Top"
                                FontSize="12"
                                Foreground="#90A4AE"
                                Text="Aucune notification">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NombreNotifications}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Notifications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,6"
                                                Padding="10"
                                                Background="#F4F6F8"
                                                CornerRadius="8">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="#263238"
                                                        Text="{Binding Titre}" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="12"
                                                        Foreground="#546E7A"
                                                        Text="{Binding Message}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="10"
                                                        Foreground="#B0BEC5"
                                                        Text="{Binding Date, StringFormat=HH:mm:ss}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Border>
</UserControl>
