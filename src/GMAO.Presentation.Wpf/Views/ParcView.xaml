<UserControl
    x:Class="GMAO.Presentation.Wpf.Views.ParcView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:GMAO.Presentation.Wpf.Converters"
    FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:EtatRespirateurVersCouleurConverter x:Key="EtatCouleur" />
        <conv:BoolVersVisibiliteConverter x:Key="BoolVisib" />
        <conv:BoolInverseVersVisibiliteConverter x:Key="BoolVisibInv" />
        <conv:StringVersVisibiliteConverter x:Key="StrVisib" />
        <conv:NullVersVisibiliteConverter x:Key="NullVisib" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Liste des respirateurs  -->
        <Border
            Grid.Column="0"
            Padding="6"
            Background="White"
            CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    ShadowDepth="2"
                    Color="#22000000" />
            </Border.Effect>
            <DockPanel>
                <Grid Margin="14,12,14,8" DockPanel.Dock="Top">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#203A43"
                        Text="Respirateurs du parc" />
                    <Button
                        Padding="10,4"
                        HorizontalAlignment="Right"
                        Background="#ECEFF1"
                        BorderThickness="0"
                        Command="{Binding ChargerCommand}"
                        Content="Actualiser"
                        Cursor="Hand"
                        Foreground="#37474F" />
                </Grid>
                <ListView
                    BorderThickness="0"
                    ItemsSource="{Binding Respirateurs}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding Selection, Mode=TwoWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="2"
                                Padding="10"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="#263238"
                                            Text="{Binding NumeroSerie}" />
                                        <TextBlock FontSize="12" Foreground="#78909C">
                                            <Run Text="{Binding ModeleNom}" /><Run Text=" · " /><Run Text="{Binding Localisation}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        Padding="9,3"
                                        VerticalAlignment="Center"
                                        Background="{Binding Etat, Converter={StaticResource EtatCouleur}}"
                                        CornerRadius="10">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding EtatLibelle}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>

        <!--  Fiche de vie + QR  -->
        <Border
            Grid.Column="2"
            Padding="22"
            Background="White"
            CornerRadius="12"
            Visibility="{Binding Selection, Converter={StaticResource NullVisib}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    ShadowDepth="2"
                    Color="#22000000" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding Selection}">
                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="#203A43"
                        Text="{Binding NumeroSerie}" />
                    <Border
                        Margin="0,8,0,0"
                        Padding="9,3"
                        HorizontalAlignment="Left"
                        Background="{Binding Etat, Converter={StaticResource EtatCouleur}}"
                        CornerRadius="10">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding EtatLibelle}" />
                    </Border>

                    <!--  QR Code  -->
                    <Border
                        Margin="0,18,0,0"
                        Padding="16"
                        HorizontalAlignment="Center"
                        Background="#F4F6F8"
                        CornerRadius="10">
                        <StackPanel>
                            <Image
                                Width="170"
                                Height="170"
                                Source="{Binding DataContext.QrCodeImage, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="10"
                                Foreground="#90A4AE"
                                Text="{Binding CodeQrTexte}" />
                        </StackPanel>
                    </Border>

                    <!--  Fiche  -->
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#90A4AE"
                            Text="FICHE TECHNIQUE" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,3"
                                Foreground="#78909C"
                                Text="Code interne" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="12,3"
                                Foreground="#37474F"
                                Text="{Binding CodeInterne}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,3"
                                Foreground="#78909C"
                                Text="Modèle" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="12,3"
                                Foreground="#37474F">
                                <Run Text="{Binding ModeleNom}" /><Run Text=" (" /><Run Text="{Binding ModeleGamme}" /><Run Text=")" />
                            </TextBlock>
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,3"
                                Foreground="#78909C"
                                Text="Versions" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="12,3"
                                Foreground="#37474F">
                                <Run Text="Logiciel " /><Run Text="{Binding VersionLogicielle}" /><Run Text="  ·  Matériel " /><Run Text="{Binding VersionMaterielle}" />
                            </TextBlock>
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,3"
                                Foreground="#78909C"
                                Text="Localisation" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="12,3"
                                Foreground="#37474F"
                                Text="{Binding Localisation}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,3"
                                Foreground="#78909C"
                                Text="Mise en service" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Margin="12,3"
                                Foreground="#37474F"
                                Text="{Binding DateMiseEnService, StringFormat=d}" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Margin="0,3"
                                Foreground="#78909C"
                                Text="Contrat" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Margin="12,3"
                                Foreground="#37474F"
                                Text="{Binding NumeroContrat, TargetNullValue=Aucun}" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="0"
                                Margin="0,3"
                                Foreground="#78909C"
                                Text="Garantie" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                Margin="12,3"
                                Foreground="#37474F"
                                Text="{Binding DateFinGarantie, StringFormat=d, TargetNullValue=N/A}" />
                        </Grid>
                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="0,18"
                        Background="#ECEFF1" />

                    <!--  Actions hors service  -->
                    <StackPanel Visibility="{Binding EstHorsService, Converter={StaticResource BoolVisibInv}}">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#C62828"
                            Text="DÉCLARER HORS SERVICE" />
                        <TextBox
                            Height="60"
                            Padding="8"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            BorderBrush="#CFD8DC"
                            Text="{Binding DataContext.MotifHorsService, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            ToolTip="Motif obligatoire" />
                        <Button
                            Margin="0,10,0,0"
                            Padding="12,8"
                            HorizontalAlignment="Left"
                            Background="#C62828"
                            BorderThickness="0"
                            Command="{Binding DataContext.DeclarerHorsServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="Déclarer hors service"
                            Cursor="Hand"
                            Foreground="White" />
                    </StackPanel>

                    <!--  Bloc hors service actif  -->
                    <StackPanel Visibility="{Binding EstHorsService, Converter={StaticResource BoolVisib}}">
                        <Border
                            Padding="14"
                            Background="#FFEBEE"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="#C62828">
                                    <Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE733;" /><Run Text=" APPAREIL HORS SERVICE" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="#B71C1C"
                                    Text="{Binding MotifHorsService}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="12"
                                    Foreground="#78909C">
                                    <Run Text="Depuis le " /><Run Text="{Binding DateHorsService, StringFormat=d}" /><Run Text=" · par " /><Run Text="{Binding AuteurHorsService}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Button
                            Margin="0,12,0,0"
                            Padding="12,8"
                            HorizontalAlignment="Left"
                            Background="#2E7D32"
                            BorderThickness="0"
                            Command="{Binding DataContext.RemettreEnServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="Remettre en service"
                            Cursor="Hand"
                            Foreground="White" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,12,0,0"
                        Foreground="#0277BD"
                        Text="{Binding DataContext.Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        TextWrapping="Wrap"
                        Visibility="{Binding DataContext.Message, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StrVisib}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
