<UserControl
    x:Class="GMAO.Presentation.Wpf.Views.UtilisateursView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:GMAO.Presentation.Wpf.Converters"
    Background="{StaticResource PinceauFondHud}"
    FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:StringVersVisibiliteConverter x:Key="StrVisib" />
        <conv:BoolInverseConverter x:Key="BoolInv" />
        <Style x:Key="Carte" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PinceauSurfaceHud}" />
            <Setter Property="BorderBrush" Value="{StaticResource PinceauSurfaceHudBordure}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="12"
                        Direction="270"
                        ShadowDepth="2"
                        Color="#1A000000" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="Champ"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Cle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#78909C" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!--  Liste + filtres  -->
        <Border
            Grid.Column="0"
            Margin="0,0,18,0"
            Style="{StaticResource Carte}">
            <DockPanel>
                <Grid Margin="0,0,0,14" DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        Style="{StaticResource Champ}"
                        Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                        ToolTip="Rechercher par nom, prénom, login ou e-mail" />
                    <ComboBox
                        Grid.Column="1"
                        Height="34"
                        VerticalContentAlignment="Center"
                        DisplayMemberPath="Libelle"
                        ItemsSource="{Binding RolesFiltre}"
                        SelectedItem="{Binding RoleFiltre, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource Cle}"
                        Text="Utilisateur" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource Cle}"
                        Text="Rôle" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource Cle}"
                        Text="Actif" />
                    <TextBlock
                        Grid.Column="3"
                        Style="{StaticResource Cle}"
                        Text="Actions" />
                </Grid>

                <ListView
                    AlternationCount="2"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource LigneTableHud}"
                    ItemsSource="{Binding Utilisateurs}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding Selection, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PinceauTexteHud}"
                                        Text="{Binding NomComplet}" />
                                    <TextBlock
                                        FontFamily="Cascadia Code, Consolas"
                                        FontSize="11"
                                        Foreground="#90A4AE"
                                        Text="{Binding Login}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource PinceauTexteHudSecondaire}"
                                    Text="{Binding RoleLibelle}" />
                                <Border
                                    Grid.Column="2"
                                    Padding="7,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A00E676" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Actif}" Value="False">
                                                    <Setter Property="Background" Value="#22FF3B30" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Oui" />
                                                <Setter Property="Foreground" Value="#00E676" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Actif}" Value="False">
                                                        <Setter Property="Text" Value="Non" />
                                                        <Setter Property="Foreground" Value="#FF6B60" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,6,0"
                                        Padding="6,3"
                                        Background="{StaticResource PinceauChipHud}"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.BasculerActifCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        Content="Activer/Désact."
                                        Cursor="Hand"
                                        FontSize="11"
                                        Foreground="{StaticResource PinceauTexteHud}" />
                                    <Button
                                        Padding="6,3"
                                        Background="#22FF3B30"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.SupprimerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        Content="Suppr."
                                        Cursor="Hand"
                                        FontSize="11"
                                        Foreground="#FF6B60" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>

        <!--  Formulaire création / modification  -->
        <Border Grid.Column="1" Style="{StaticResource Carte}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PinceauTexteHud}"
                            Text="{Binding TitreFormulaire}" />
                        <Button
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            Background="{StaticResource PinceauChipHud}"
                            BorderThickness="0"
                            Command="{Binding NouveauCommand}"
                            Content="Nouveau"
                            Cursor="Hand"
                            Foreground="{StaticResource PinceauTexteHud}" />
                    </Grid>

                    <TextBlock Style="{StaticResource Cle}" Text="Login" />
                    <TextBox
                        IsEnabled="{Binding EstCreation}"
                        Style="{StaticResource Champ}"
                        Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Cle}" Text="Prénom" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Cle}" Text="Nom" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Cle}" Text="E-mail" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Cle}" Text="Téléphone" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Cle}" Text="Rôle" />
                    <ComboBox
                        Height="34"
                        Margin="0,0,0,10"
                        VerticalContentAlignment="Center"
                        DisplayMemberPath="Libelle"
                        ItemsSource="{Binding Roles}"
                        SelectedValue="{Binding Role, Mode=TwoWay}"
                        SelectedValuePath="Role" />

                    <TextBlock Style="{StaticResource Cle}" Text="Mot de passe" />
                    <PasswordBox
                        x:Name="PbMotDePasse"
                        Height="34"
                        Margin="0,0,0,4"
                        Padding="8,0"
                        VerticalContentAlignment="Center"
                        Background="#0E141B"
                        BorderBrush="#2E3A44"
                        Foreground="{StaticResource PinceauTexteHud}" />
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="11"
                        Foreground="#B0BEC5"
                        Text="Min. 8 caractères, 1 majuscule, 1 minuscule, 1 chiffre."
                        TextWrapping="Wrap" />

                    <Button
                        Margin="0,0,0,8"
                        Padding="14,9"
                        Background="#00E5A8"
                        BorderThickness="0"
                        Command="{Binding EnregistrerCommand}"
                        Content="Enregistrer"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Foreground="#0A0E12" />
                    <Button
                        Padding="14,9"
                        Background="{StaticResource PinceauChipHud}"
                        BorderThickness="0"
                        Command="{Binding ReinitialiserMotDePasseCommand}"
                        Content="Réinitialiser le mot de passe"
                        Cursor="Hand"
                        Foreground="{StaticResource PinceauTexteHud}"
                        IsEnabled="{Binding EstCreation, Converter={StaticResource BoolInv}}" />

                    <Border
                        Margin="0,14,0,0"
                        Padding="10"
                        CornerRadius="8"
                        Visibility="{Binding Message, Converter={StaticResource StrVisib}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1A29B6F6" />
                                <Setter Property="BorderBrush" Value="#3329B6F6" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageEstErreur}" Value="True">
                                        <Setter Property="Background" Value="#22FF3B30" />
                                        <Setter Property="BorderBrush" Value="#66FF3B30" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            Foreground="{StaticResource PinceauTexteHud}"
                            Text="{Binding Message}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
