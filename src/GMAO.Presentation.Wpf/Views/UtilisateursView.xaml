<UserControl x:Class="GMAO.Presentation.Wpf.Views.UtilisateursView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GMAO.Presentation.Wpf.Converters"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:StringVersVisibiliteConverter x:Key="StrVisib"/>
        <conv:BoolInverseConverter x:Key="BoolInv"/>
        <Style x:Key="Carte" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect Color="#1A000000" BlurRadius="12" ShadowDepth="2" Direction="270"/></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Champ" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Cle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#78909C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Liste + filtres -->
        <Border Grid.Column="0" Style="{StaticResource Carte}" Margin="0,0,18,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource Champ}" Margin="0,0,10,0"
                             Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             ToolTip="Rechercher par nom, prénom, login ou e-mail"/>
                    <ComboBox Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                              ItemsSource="{Binding RolesFiltre}" SelectedItem="{Binding RoleFiltre, Mode=TwoWay}"
                              DisplayMemberPath="Libelle"/>
                </Grid>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Utilisateur" Style="{StaticResource Cle}"/>
                    <TextBlock Grid.Column="1" Text="Rôle" Style="{StaticResource Cle}"/>
                    <TextBlock Grid.Column="2" Text="Actif" Style="{StaticResource Cle}"/>
                    <TextBlock Grid.Column="3" Text="Actions" Style="{StaticResource Cle}"/>
                </Grid>

                <ListView ItemsSource="{Binding Utilisateurs}" SelectedItem="{Binding Selection, Mode=TwoWay}"
                          BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,8"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding NomComplet}" FontWeight="SemiBold" Foreground="#263238"/>
                                    <TextBlock Text="{Binding Login}" Foreground="#90A4AE" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding RoleLibelle}" Foreground="#546E7A" VerticalAlignment="Center" FontSize="12"/>
                                <Border Grid.Column="2" CornerRadius="8" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Actif}" Value="False">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Oui"/>
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Actif}" Value="False">
                                                        <Setter Property="Text" Value="Non"/>
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Activer/Désact." FontSize="11" Padding="6,3" Cursor="Hand"
                                            Background="#ECEFF1" BorderThickness="0" Margin="0,0,6,0"
                                            Command="{Binding DataContext.BasculerActifCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Suppr." FontSize="11" Padding="6,3" Cursor="Hand"
                                            Background="#FFEBEE" Foreground="#C62828" BorderThickness="0"
                                            Command="{Binding DataContext.SupprimerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Formulaire création / modification -->
        <Border Grid.Column="1" Style="{StaticResource Carte}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="{Binding TitreFormulaire}" FontSize="16" FontWeight="SemiBold" Foreground="#203A43"/>
                        <Button Content="Nouveau" HorizontalAlignment="Right" Padding="10,5" Cursor="Hand"
                                Background="#ECEFF1" BorderThickness="0" Command="{Binding NouveauCommand}"/>
                    </Grid>

                    <TextBlock Text="Login" Style="{StaticResource Cle}"/>
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding EstCreation}"/>
                    <TextBlock Text="Prénom" Style="{StaticResource Cle}"/>
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Nom" Style="{StaticResource Cle}"/>
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="E-mail" Style="{StaticResource Cle}"/>
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Téléphone" Style="{StaticResource Cle}"/>
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Rôle" Style="{StaticResource Cle}"/>
                    <ComboBox Height="34" VerticalContentAlignment="Center" Margin="0,0,0,10"
                              ItemsSource="{Binding Roles}" DisplayMemberPath="Libelle"
                              SelectedValuePath="Role" SelectedValue="{Binding Role, Mode=TwoWay}"/>

                    <TextBlock Text="Mot de passe" Style="{StaticResource Cle}"/>
                    <PasswordBox x:Name="PbMotDePasse" Height="34" Padding="8,0" VerticalContentAlignment="Center"
                                 BorderBrush="#CFD8DC" Margin="0,0,0,4"/>
                    <TextBlock Text="Min. 8 caractères, 1 majuscule, 1 minuscule, 1 chiffre."
                               Foreground="#B0BEC5" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <Button Content="Enregistrer" Padding="14,9" Margin="0,0,0,8"
                            Background="#2C5364" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Command="{Binding EnregistrerCommand}"/>
                    <Button Content="Réinitialiser le mot de passe" Padding="14,9"
                            Background="#ECEFF1" BorderThickness="0" Cursor="Hand"
                            Command="{Binding ReinitialiserMotDePasseCommand}"
                            IsEnabled="{Binding EstCreation, Converter={StaticResource BoolInv}}"/>

                    <Border CornerRadius="8" Padding="10" Margin="0,14,0,0"
                            Visibility="{Binding Message, Converter={StaticResource StrVisib}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageEstErreur}" Value="True">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#37474F"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
