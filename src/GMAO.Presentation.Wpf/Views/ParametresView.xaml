<UserControl
    x:Class="GMAO.Presentation.Wpf.Views.ParametresView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:GMAO.Presentation.Wpf.Converters"
    FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:StringVersVisibiliteConverter x:Key="StrVisib" />
        <Style x:Key="Carte" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="12"
                        Direction="270"
                        ShadowDepth="2"
                        Color="#1A000000" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitreSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#203A43" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Cle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#78909C" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Valeur" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#37474F" />
            <Setter Property="Margin" Value="12,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="28,24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <!--  Profil  -->
            <Border Style="{StaticResource Carte}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitreSection}" Text="Profil" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource Cle}"
                            Text="Nom complet" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Style="{StaticResource Valeur}"
                            Text="{Binding UtilisateurNom}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource Cle}"
                            Text="Identifiant" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource Valeur}"
                            Text="{Binding Login}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource Cle}"
                            Text="Rôle" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource Valeur}"
                            Text="{Binding RoleLibelle}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource Cle}"
                            Text="E-mail" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource Valeur}"
                            Text="{Binding Email}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Sécurité  -->
            <Border Style="{StaticResource Carte}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitreSection}" Text="Changer le mot de passe" />
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource Cle}"
                        Text="Mot de passe actuel" />
                    <PasswordBox
                        x:Name="PbAncien"
                        Height="36"
                        Margin="0,0,0,10"
                        Padding="8,0"
                        VerticalContentAlignment="Center"
                        BorderBrush="#CFD8DC" />
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource Cle}"
                        Text="Nouveau mot de passe (Min. 8 caractères, 1 majuscule, 1 minuscule, 1 chiffre)" />
                    <PasswordBox
                        x:Name="PbNouveau"
                        Height="36"
                        Margin="0,0,0,10"
                        Padding="8,0"
                        VerticalContentAlignment="Center"
                        BorderBrush="#CFD8DC" />
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource Cle}"
                        Text="Confirmer le nouveau mot de passe" />
                    <PasswordBox
                        x:Name="PbConfirme"
                        Height="36"
                        Margin="0,0,0,12"
                        Padding="8,0"
                        VerticalContentAlignment="Center"
                        BorderBrush="#CFD8DC" />
                    <Button
                        Padding="14,8"
                        HorizontalAlignment="Left"
                        Background="#2C5364"
                        BorderThickness="0"
                        Command="{Binding ChangerMotDePasseCommand}"
                        Content="Modifier le mot de passe"
                        Cursor="Hand"
                        Foreground="White" />
                    <TextBlock
                        Margin="0,12,0,0"
                        Foreground="#0277BD"
                        Text="{Binding MessageMotDePasse}"
                        TextWrapping="Wrap"
                        Visibility="{Binding MessageMotDePasse, Converter={StaticResource StrVisib}}" />
                </StackPanel>
            </Border>

            <!--  Historique des connexions  -->
            <Border Style="{StaticResource Carte}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitreSection}" Text="Historique des connexions" />
                    <ItemsControl ItemsSource="{Binding Historique}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="12"
                                        Foreground="#37474F"
                                        Text="{Binding DateConnexion, StringFormat=g}" />
                                    <Border
                                        Grid.Column="1"
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        CornerRadius="9">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F5E9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Succes}" Value="False">
                                                        <Setter Property="Background" Value="#FFEBEE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{Binding Statut}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Succes}" Value="False">
                                                            <Setter Property="Foreground" Value="#C62828" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#90A4AE">
                                        <Run Text="{Binding AdresseIp, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Detail, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  À propos  -->
            <Border Style="{StaticResource Carte}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitreSection}" Text="À propos" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource Cle}"
                            Text="Application" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource Valeur}"
                            Text="GMAO Datex-Ohmeda — MEDICANA" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource Cle}"
                            Text="Version" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource Valeur}"
                            Text="{Binding Version}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource Cle}"
                            Text="Base de données" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource Valeur}"
                            Text="{Binding CheminBase}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource Cle}"
                            Text="Serveur notifications" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource Valeur}"
                            Text="{Binding ServeurNotifications}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
